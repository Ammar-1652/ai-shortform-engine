{
  "$defs": {
    "OpenverseMediaRecord": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution"
        },
        "creator": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Creator"
        },
        "creator_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Creator Url"
        },
        "direct_download_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direct Download Url"
        },
        "discovered_at": {
          "format": "date-time",
          "title": "Discovered At",
          "type": "string"
        },
        "duration_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Us"
        },
        "file_type": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Type"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "landing_url": {
          "title": "Landing Url",
          "type": "string"
        },
        "license_code": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Code"
        },
        "license_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Url"
        },
        "license_version": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Version"
        },
        "media_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Media Id",
          "type": "string"
        },
        "media_type": {
          "enum": [
            "image",
            "audio"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "policy_reason": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Reason"
        },
        "provider": {
          "const": "openverse",
          "default": "openverse",
          "title": "Provider",
          "type": "string"
        },
        "rights_status": {
          "default": "unverified",
          "enum": [
            "unverified",
            "eligible_pending_verification",
            "blocked"
          ],
          "title": "Rights Status",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_name": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Name"
        },
        "source_response_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Response Sha256",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Tags",
          "type": "array"
        },
        "title": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "media_id",
        "media_type",
        "title",
        "landing_url",
        "source_response_sha256",
        "discovered_at"
      ],
      "title": "OpenverseMediaRecord",
      "type": "object"
    },
    "OpenverseSearchRequest": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "length": {
          "anyOf": [
            {
              "enum": [
                "shortest",
                "short",
                "medium",
                "long"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length"
        },
        "license_filter": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "License Filter",
          "type": "array"
        },
        "media_type": {
          "enum": [
            "image",
            "audio"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "page": {
          "default": 1,
          "maximum": 500,
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "page_size": {
          "default": 10,
          "maximum": 20,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "query": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "query"
      ],
      "title": "OpenverseSearchRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "page": {
      "minimum": 1,
      "title": "Page",
      "type": "integer"
    },
    "page_count": {
      "minimum": 0,
      "title": "Page Count",
      "type": "integer"
    },
    "request": {
      "$ref": "#/$defs/OpenverseSearchRequest"
    },
    "response_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Response Sha256",
      "type": "string"
    },
    "result_count": {
      "minimum": 0,
      "title": "Result Count",
      "type": "integer"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/OpenverseMediaRecord"
      },
      "maxItems": 20,
      "title": "Results",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "request",
    "result_count",
    "page_count",
    "page",
    "results",
    "response_sha256"
  ],
  "title": "OpenverseSearchResponse",
  "type": "object"
}
