      "const": "yuv420p",
      "default": "yuv420p",
      "title": "Pixel Format",
      "type": "string"
    },
    "profile_id": {
      "const": "hero-draft-v1",
      "default": "hero-draft-v1",
      "title": "Profile Id",
      "type": "string"
    },
    "renderer_recipe_version": {
      "const": "hero-draft-renderer-v1",
      "default": "hero-draft-renderer-v1",
      "title": "Renderer Recipe Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "video_codec": {
      "const": "h264",
      "default": "h264",
      "title": "Video Codec",
      "type": "string"
    },
    "video_fit": {
      "const": "contain",
      "default": "contain",
      "title": "Video Fit",
      "type": "string"
    },
    "width": {
      "const": 1080,
      "default": 1080,
      "title": "Width",
      "type": "integer"
    }
