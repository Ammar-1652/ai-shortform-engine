{
  "$defs": {
    "ArtifactProvenance": {
      "additionalProperties": false,
      "description": "Required lineage for stored media decisions and derived artifacts.\n\n``source_asset_ids`` is empty only for records that are not derived from a\nsource video (for example a newly created project). Derived media must list\nthe source.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "inputs_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs Sha256"
        },
        "job_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "parent_artifact_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_asset_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Source Asset Ids",
          "type": "array"
        },
        "tool": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "tool",
        "tool_version"
      ],
      "title": "ArtifactProvenance",
      "type": "object"
    },
    "OutputInterval": {
      "additionalProperties": false,
      "description": "An interval on the output timeline produced by the candidate's time map.",
      "properties": {
        "clock": {
          "const": "output",
          "default": "output",
          "title": "Clock",
          "type": "string"
        },
        "output_end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output End Us",
          "type": "integer"
        },
        "output_start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output Start Us",
          "type": "integer"
        }
      },
      "required": [
        "output_start_us",
        "output_end_us"
      ],
      "title": "OutputInterval",
      "type": "object"
    },
    "TreatmentObservationFrame": {
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "pattern": "^editorial/treatment-observations/[A-Za-z0-9._:/-]+\\.jpg$",
          "title": "Relative Path",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "timestamp_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Timestamp Us",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "timestamp_us"
      ],
      "title": "TreatmentObservationFrame",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Decoded, reviewed observation of a selected visual asset.",
  "properties": {
    "analyzer_version": {
      "const": "ffmpeg-frame-probe-v1",
      "default": "ffmpeg-frame-probe-v1",
      "title": "Analyzer Version",
      "type": "string"
    },
    "asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Asset Id",
      "type": "string"
    },
    "frames": {
      "items": {
        "$ref": "#/$defs/TreatmentObservationFrame"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Frames",
      "type": "array"
    },
    "media_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Media Sha256",
      "type": "string"
    },
    "observation_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Observation Id",
      "type": "string"
    },
    "observed_labels": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Observed Labels",
      "type": "array"
    },
    "output_interval": {
      "$ref": "#/$defs/OutputInterval"
    },
    "provenance": {
      "$ref": "#/$defs/ArtifactProvenance"
    },
    "relevance_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Relevance Score",
      "type": "number"
    },
    "relevance_threshold": {
      "maximum": 1,
      "minimum": 0,
      "title": "Relevance Threshold",
      "type": "number"
    },
    "review_note": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Review Note",
      "type": "string"
    },
    "reviewed_by": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Reviewed By",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Asset Id",
      "type": "string"
    },
    "source_evidence_ids": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Source Evidence Ids",
      "type": "array"
    }
  },
  "required": [
    "observation_id",
    "asset_id",
    "source_asset_id",
    "media_sha256",
    "output_interval",
    "source_evidence_ids",
    "frames",
    "observed_labels",
    "relevance_score",
    "relevance_threshold",
    "reviewed_by",
    "review_note",
    "provenance"
  ],
  "title": "TreatmentAssetObservation",
  "type": "object"
}
