            "source_footage",
            "clean_cut",
            "hold",
            "silence",
            "none"
          ],
          "title": "Fallback",
          "type": "string"
        },
        "layer": {
          "const": "broll",
          "default": "broll",
          "title": "Layer",
          "type": "string"
        },
        "negative_terms": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Negative Terms",
          "type": "array"
        },
        "omission_reason": {
          "anyOf": [
            {
              "enum": [
                "dialogue_clarity",
                "no_relevant_asset",
                "face_collision",
                "protected_region_collision",
                "quiet_payoff",
                "short_interval",
                "no_semantic_cut",
                "policy_preference",
                "unsupported_capability",
                "missing_evidence"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Omission Reason"
        },
        "purpose": {
          "anyOf": [
            {
              "$ref": "#/$defs/MotionPurpose"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "query_terms": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Query Terms",
          "type": "array"
        },
        "rationale": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "relevance_note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relevance Note"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "context",
                "proof",
                "process",
                "reaction",
                "result",
                "contrast",
                "atmosphere",
                "product_detail"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_evidence_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "state": {
          "enum": [
            "use",
            "omit_with_reason",
            "blocked_by_policy",
            "needs_review"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "rationale"
      ],
      "title": "BrollTreatmentDecision",
      "type": "object"
    },
