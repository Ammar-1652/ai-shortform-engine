            "enum": [
              "local",
              "envato",
              "openverse"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Provider Classes",
          "type": "array"
        },
        "provider_response_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
