    "BrollTreatmentDecision": {
      "additionalProperties": false,
      "properties": {
        "asset_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Asset Ids",
          "type": "array"
