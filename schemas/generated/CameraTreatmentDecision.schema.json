{
  "$defs": {
    "MotionPurpose": {
      "enum": [
        "number",
        "comparison",
        "product_feature",
        "process_step",
        "concept",
        "visual_reveal",
        "key_phrase",
        "data",
        "ui_interaction"
      ],
      "title": "MotionPurpose",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_ids": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Asset Ids",
      "type": "array"
    },
    "asset_request_ids": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Asset Request Ids",
      "type": "array"
    },
    "event_ids": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Event Ids",
      "type": "array"
    },
    "fallback": {
      "default": "none",
      "enum": [
        "source_footage",
        "clean_cut",
        "hold",
        "silence",
        "none"
      ],
      "title": "Fallback",
      "type": "string"
    },
    "intensity": {
      "default": "gentle",
      "enum": [
        "quiet",
        "gentle",
        "active",
        "peak"
      ],
      "title": "Intensity",
      "type": "string"
    },
    "layer": {
      "const": "camera",
      "default": "camera",
      "title": "Layer",
      "type": "string"
    },
    "mode": {
      "anyOf": [
        {
          "enum": [
            "static",
            "push_in",
            "pull_out",
            "follow_subject",
            "reframe",
            "settle"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mode"
    },
    "omission_reason": {
      "anyOf": [
        {
          "enum": [
            "dialogue_clarity",
            "no_relevant_asset",
            "face_collision",
            "protected_region_collision",
            "quiet_payoff",
            "short_interval",
            "no_semantic_cut",
            "policy_preference",
            "unsupported_capability",
            "missing_evidence"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Omission Reason"
    },
    "protected_regions": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Protected Regions",
      "type": "array"
    },
    "purpose": {
      "anyOf": [
        {
          "$ref": "#/$defs/MotionPurpose"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rationale": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_evidence_ids": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Source Evidence Ids",
      "type": "array"
    },
    "state": {
      "enum": [
        "use",
        "omit_with_reason",
        "blocked_by_policy",
        "needs_review"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "state",
    "rationale"
  ],
  "title": "CameraTreatmentDecision",
  "type": "object"
}
