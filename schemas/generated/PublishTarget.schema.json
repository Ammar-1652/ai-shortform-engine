{
  "additionalProperties": false,
  "description": "Where a verified local package would be offered. This stores no credentials.",
  "properties": {
    "account_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Account Label",
      "type": "string"
    },
    "campaign_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Campaign Id",
      "type": "string"
    },
    "delivery_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Delivery Id",
      "type": "string"
    },
    "description": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "destination_id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Destination Id",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "platform": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Platform",
      "type": "string"
    },
    "privacy": {
      "default": "public",
      "enum": [
        "public",
        "unlisted",
        "private"
      ],
      "title": "Privacy",
      "type": "string"
    },
    "scheduled_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scheduled At"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Tags",
      "type": "array"
    },
    "title": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "platform",
    "account_label",
    "destination_id",
    "title",
    "description",
    "campaign_id",
    "delivery_id",
    "manifest_sha256"
  ],
  "title": "PublishTarget",
  "type": "object"
}
