{
  "additionalProperties": false,
  "description": "Codex evidence for text that must not be guessed.",
  "properties": {
    "note": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Note",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_sha256": {
      "default": "",
      "pattern": "^$|^[0-9a-f]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "source_url": {
      "default": "",
      "maxLength": 500,
      "title": "Source Url",
      "type": "string"
    },
    "status": {
      "const": "verified",
      "default": "verified",
      "title": "Status",
      "type": "string"
    },
    "subject_kind": {
      "enum": [
        "quran",
        "quotation",
        "proper_noun",
        "number",
        "factual_claim"
      ],
      "title": "Subject Kind",
      "type": "string"
    },
    "verification_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Verification Id",
      "type": "string"
    }
  },
  "required": [
    "verification_id",
    "subject_kind",
    "note"
  ],
  "title": "SpeechVerification",
  "type": "object"
}
