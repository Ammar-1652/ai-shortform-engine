{
  "additionalProperties": false,
  "description": "One measured step. Missing evidence stays blocked or unavailable.",
  "properties": {
    "artifact_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Id"
    },
    "artifact_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Sha256"
    },
    "cache_hit": {
      "title": "Cache Hit",
      "type": "boolean"
    },
    "delivery_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delivery Id"
    },
    "delivery_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delivery Manifest Sha256"
    },
    "elapsed_ms": {
      "minimum": 0,
      "title": "Elapsed Ms",
      "type": "integer"
    },
    "error_category": {
      "default": "none",
      "maxLength": 40,
      "title": "Error Category",
      "type": "string"
    },
    "execution": {
      "default": "recorded_evidence",
      "enum": [
        "recorded_evidence",
        "executed_stage",
        "cache_hit",
        "not_run",
        "blocked",
        "unavailable"
      ],
      "title": "Execution",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "human_action_required": {
      "default": false,
      "title": "Human Action Required",
      "type": "boolean"
    },
    "job_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Id"
    },
    "readiness_classification": {
      "default": "not_recorded",
      "maxLength": 40,
      "title": "Readiness Classification",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Stage",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_run",
        "unavailable",
        "blocked_for_external_publish"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "stage",
    "status",
    "started_at",
    "finished_at",
    "elapsed_ms",
    "cache_hit"
  ],
  "title": "BenchmarkStage",
  "type": "object"
}
