{
  "additionalProperties": false,
  "description": "What an accepted file contained. The file path is not stored.",
  "properties": {
    "profile_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Profile Id",
      "type": "string"
    },
    "row_count": {
      "minimum": 0,
      "title": "Row Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "accepted",
        "replayed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "profile_id",
    "row_count",
    "status"
  ],
  "title": "ImportValidationSummary",
  "type": "object"
}
