{
  "$defs": {
    "CampaignMode": {
      "enum": [
        "organic",
        "paid_campaign"
      ],
      "title": "CampaignMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Configuration for organic or paid work. Both modes use the same core.",
  "properties": {
    "mode": {
      "$ref": "#/$defs/CampaignMode"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "objective": {
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "policy_ids": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Policy Ids",
      "type": "array"
    },
    "profile_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Profile Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "profile_id",
    "name",
    "mode",
    "objective",
    "policy_ids"
  ],
  "title": "CampaignProfile",
  "type": "object"
}
