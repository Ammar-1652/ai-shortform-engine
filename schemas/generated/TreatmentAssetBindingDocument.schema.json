{
  "$defs": {
    "ArtifactProvenance": {
      "additionalProperties": false,
      "description": "Required lineage for stored media decisions and derived artifacts.\n\n``source_asset_ids`` is empty only for records that are not derived from a\nsource video (for example a newly created project). Derived media must list\nthe source.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "inputs_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs Sha256"
        },
        "job_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "parent_artifact_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_asset_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Source Asset Ids",
          "type": "array"
        },
        "tool": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "tool",
        "tool_version"
      ],
      "title": "ArtifactProvenance",
      "type": "object"
    },
    "DirectionAssetPlacement": {
      "additionalProperties": false,
      "description": "A reviewed, source-grounded placement for one local asset.\n\nAsset timing is never inferred from the number of assets. The selected\noption must name the exact output interval, the source evidence that makes\nthe asset relevant, and a plain-language editorial reason. The renderer\nconsumes this declarative record; it cannot execute operator code.",
      "properties": {
        "acquisition_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acquisition Id"
        },
        "asset_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Asset Id",
          "type": "string"
        },
        "asset_status": {
          "default": "acquired",
          "enum": [
            "pending",
            "selected",
            "acquired",
            "blocked",
            "unavailable"
          ],
          "title": "Asset Status",
          "type": "string"
        },
        "asset_tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 24,
          "title": "Asset Tags",
          "type": "array"
        },
        "gain_db": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": -24,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gain Db"
        },
        "interval": {
          "$ref": "#/$defs/OutputInterval"
        },
        "kind": {
          "enum": [
            "graphic",
            "audio"
          ],
          "title": "Kind",
          "type": "string"
        },
        "license_evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Evidence Sha256"
        },
        "observation_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Id"
        },
        "observation_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Sha256"
        },
        "output_region": {
          "anyOf": [
            {
              "$ref": "#/$defs/DirectionPlacementRegion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "placement_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Placement Id",
          "type": "string"
        },
        "provider_response_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Response Sha256"
        },
        "purpose": {
          "$ref": "#/$defs/MotionPurpose"
        },
        "registered_asset_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registered Asset Sha256"
        },
        "relevance_note": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Relevance Note",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Id"
        },
        "source_evidence_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "source_in_us": {
          "default": 0,
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Source In Us",
          "type": "integer"
        }
      },
      "required": [
        "placement_id",
        "asset_id",
        "kind",
        "interval",
        "source_evidence_ids",
        "purpose",
        "relevance_note"
      ],
      "title": "DirectionAssetPlacement",
      "type": "object"
    },
    "DirectionPlacementRegion": {
      "additionalProperties": false,
      "description": "Reviewed output-space rectangle for a visual asset placement.",
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1920,
          "title": "Height",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1080,
          "title": "Width",
          "type": "integer"
        },
        "x": {
          "maximum": 1080,
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "maximum": 1920,
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "DirectionPlacementRegion",
      "type": "object"
    },
    "MotionPurpose": {
      "enum": [
        "number",
        "comparison",
        "product_feature",
        "process_step",
        "concept",
        "visual_reveal",
        "key_phrase",
        "data",
        "ui_interaction"
      ],
      "title": "MotionPurpose",
      "type": "string"
    },
    "OutputInterval": {
      "additionalProperties": false,
      "description": "An interval on the output timeline produced by the candidate's time map.",
      "properties": {
        "clock": {
          "const": "output",
          "default": "output",
          "title": "Clock",
          "type": "string"
        },
        "output_end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output End Us",
          "type": "integer"
        },
        "output_start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output Start Us",
          "type": "integer"
        }
      },
      "required": [
        "output_start_us",
        "output_end_us"
      ],
      "title": "OutputInterval",
      "type": "object"
    },
    "TreatmentAssetObservation": {
      "additionalProperties": false,
      "description": "Decoded, reviewed observation of a selected visual asset.",
      "properties": {
        "analyzer_version": {
          "default": "ffmpeg-frame-probe-v1",
          "enum": [
            "ffmpeg-frame-probe-v1",
            "ffmpeg-frame-probe-v2"
          ],
          "title": "Analyzer Version",
          "type": "string"
        },
        "asset_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Asset Id",
          "type": "string"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/TreatmentObservationFrame"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Frames",
          "type": "array"
        },
        "media_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Media Sha256",
          "type": "string"
        },
        "observation_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Observation Id",
          "type": "string"
        },
        "observed_labels": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Observed Labels",
          "type": "array"
        },
        "output_interval": {
          "$ref": "#/$defs/OutputInterval"
        },
        "provenance": {
          "$ref": "#/$defs/ArtifactProvenance"
        },
        "relevance_score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Relevance Score",
          "type": "number"
        },
        "relevance_threshold": {
          "maximum": 1,
          "minimum": 0,
          "title": "Relevance Threshold",
          "type": "number"
        },
        "review_note": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Review Note",
          "type": "string"
        },
        "reviewed_by": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reviewed By",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_asset_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Asset Id",
          "type": "string"
        },
        "source_evidence_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "source_in_us": {
          "default": 0,
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Source In Us",
          "type": "integer"
        },
        "source_out_us": {
          "anyOf": [
            {
              "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
              "maximum": 604800000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Out Us"
        }
      },
      "required": [
        "observation_id",
        "asset_id",
        "source_asset_id",
        "media_sha256",
        "output_interval",
        "source_evidence_ids",
        "frames",
        "observed_labels",
        "relevance_score",
        "relevance_threshold",
        "reviewed_by",
        "review_note",
        "provenance"
      ],
      "title": "TreatmentAssetObservation",
      "type": "object"
    },
    "TreatmentAssetRequest": {
      "additionalProperties": false,
      "description": "A bounded provider request produced from a source-grounded beat.",
      "properties": {
        "acquisition_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acquisition Id"
        },
        "beat_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Beat Id",
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/OutputInterval"
        },
        "kind": {
          "enum": [
            "graphic",
            "audio"
          ],
          "title": "Kind",
          "type": "string"
        },
        "license_evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Evidence Sha256"
        },
        "negative_terms": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Negative Terms",
          "type": "array"
        },
        "provider_classes": {
          "items": {
            "enum": [
              "local",
              "envato",
              "openverse"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Provider Classes",
          "type": "array"
        },
        "provider_response_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Response Sha256"
        },
        "query_terms": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Query Terms",
          "type": "array"
        },
        "registered_asset_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registered Asset Id"
        },
        "registered_asset_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registered Asset Sha256"
        },
        "relevance_threshold": {
          "default": 0.85,
          "maximum": 1,
          "minimum": 0,
          "title": "Relevance Threshold",
          "type": "number"
        },
        "request_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Request Id",
          "type": "string"
        },
        "role": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Id"
        },
        "source_evidence_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "selected",
            "acquired",
            "blocked",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "beat_id",
        "kind",
        "role",
        "query_terms",
        "provider_classes",
        "interval",
        "source_evidence_ids"
      ],
      "title": "TreatmentAssetRequest",
      "type": "object"
    },
    "TreatmentAssetVerification": {
      "additionalProperties": false,
      "description": "Evidence returned only after an existing provider/rights boundary verifies an asset.",
      "properties": {
        "acquisition_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Acquisition Id",
          "type": "string"
        },
        "license_evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "License Evidence Sha256",
          "type": "string"
        },
        "media_kind": {
          "enum": [
            "graphic",
            "audio"
          ],
          "title": "Media Kind",
          "type": "string"
        },
        "provider": {
          "enum": [
            "envato",
            "openverse",
            "local"
          ],
          "title": "Provider",
          "type": "string"
        },
        "provider_response_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Provider Response Sha256",
          "type": "string"
        },
        "registered_asset_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Registered Asset Id",
          "type": "string"
        },
        "registered_asset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Registered Asset Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Selection Id",
          "type": "string"
        },
        "status": {
          "const": "verified",
          "default": "verified",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "provider_response_sha256",
        "selection_id",
        "acquisition_id",
        "license_evidence_sha256",
        "registered_asset_id",
        "registered_asset_sha256",
        "media_kind"
      ],
      "title": "TreatmentAssetVerification",
      "type": "object"
    },
    "TreatmentObservationFrame": {
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "pattern": "^editorial/treatment-observations/[A-Za-z0-9._:/-]+\\.jpg$",
          "title": "Relative Path",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "timestamp_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Timestamp Us",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "timestamp_us"
      ],
      "title": "TreatmentObservationFrame",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable persisted request-to-placement handoff for a treatment asset.",
  "properties": {
    "binding_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Binding Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/TreatmentAssetObservation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "placement": {
      "$ref": "#/$defs/DirectionAssetPlacement"
    },
    "provenance": {
