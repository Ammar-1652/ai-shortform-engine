{
  "$defs": {
    "CampaignPolicyRule": {
      "additionalProperties": false,
      "description": "One hard rule. Ambiguous rules ask the operator instead of guessing.",
      "properties": {
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "implementation_mode": {
          "enum": [
            "external_black_box_ai_tool",
            "clipforge_native_editor",
            "human_supplied_asset",
            "voice_narration_provider"
          ],
          "title": "Implementation Mode",
          "type": "string"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "allowed",
            "blocked",
            "needs_operator_confirmation",
            "needs_policy_clarification",
            "needs_operator_clarification",
            "rights_unverified",
            "unsupported_language",
            "unsupported_feature"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "rule_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Rule Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "name",
        "description",
        "implementation_mode",
        "outcome"
      ],
      "title": "CampaignPolicyRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The hash-bound policy snapshot for one campaign.",
  "properties": {
    "allowed_platforms": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Allowed Platforms",
      "type": "array"
    },
    "campaign_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Campaign Id",
      "type": "string"
    },
    "default_language": {
      "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$",
      "title": "Default Language",
      "type": "string"
    },
    "policy_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Policy Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/CampaignPolicyRule"
      },
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Source Name",
      "type": "string"
    }
  },
  "required": [
    "policy_id",
    "campaign_id",
    "policy_sha256",
    "source_name",
    "rules",
    "allowed_platforms",
    "default_language"
  ],
  "title": "CampaignPolicy",
  "type": "object"
}
