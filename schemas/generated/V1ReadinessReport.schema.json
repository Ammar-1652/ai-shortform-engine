{
  "$defs": {
    "ArtifactProvenance": {
      "additionalProperties": false,
      "description": "Required lineage for stored media decisions and derived artifacts.\n\n``source_asset_ids`` is empty only for records that are not derived from a\nsource video (for example a newly created project). Derived media must list\nthe source.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "inputs_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs Sha256"
        },
        "job_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "parent_artifact_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_asset_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Source Asset Ids",
          "type": "array"
        },
        "tool": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "tool",
        "tool_version"
      ],
      "title": "ArtifactProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What is ready, what is blocked, and what a person still has to do.",
  "properties": {
    "benchmark_run_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Benchmark Run Id",
      "type": "string"
    },
    "blocking_limitations": {
      "items": {
        "type": "string"
      },
      "title": "Blocking Limitations",
      "type": "array"
    },
    "editorial": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_run",
        "unavailable"
      ],
      "title": "Editorial",
      "type": "string"
    },
    "local_delivery": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_run",
        "unavailable"
      ],
      "title": "Local Delivery",
      "type": "string"
    },
    "manual_steps": {
      "items": {
        "type": "string"
      },
      "title": "Manual Steps",
      "type": "array"
    },
    "overall": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_run",
        "unavailable"
      ],
      "title": "Overall",
      "type": "string"
    },
    "platform_publishing": {
      "const": "not_implemented",
      "default": "not_implemented",
      "title": "Platform Publishing",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/ArtifactProvenance"
    },
    "qa": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_run",
        "unavailable"
      ],
      "title": "Qa",
      "type": "string"
    },
    "real_source_reason": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Real Source Reason",
      "type": "string"
    },
    "real_source_verified": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_run",
        "unavailable"
      ],
      "title": "Real Source Verified",
      "type": "string"
    },
    "rights": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_run",
        "unavailable"
      ],
      "title": "Rights",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "technical": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_run",
        "unavailable"
      ],
      "title": "Technical",
      "type": "string"
    },
    "voicestudio": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_run",
        "unavailable"
      ],
      "title": "Voicestudio",
      "type": "string"
    }
  },
  "required": [
    "benchmark_run_id",
    "technical",
    "editorial",
    "rights",
    "qa",
    "local_delivery",
    "voicestudio",
    "real_source_verified",
    "real_source_reason",
    "overall",
    "provenance"
  ],
  "title": "V1ReadinessReport",
  "type": "object"
}
