{
  "additionalProperties": false,
  "description": "Serializable numeric style choices consumed by Python and Remotion.",
  "properties": {
    "accent": {
      "pattern": "^#[0-9a-fA-F]{6}$",
      "title": "Accent",
      "type": "string"
    },
    "caption_max_chars": {
      "maximum": 64,
      "minimum": 16,
      "title": "Caption Max Chars",
      "type": "integer"
    },
    "caption_max_lines": {
      "const": 1,
      "default": 1,
      "title": "Caption Max Lines",
      "type": "integer"
    },
    "caption_max_words": {
      "maximum": 8,
      "minimum": 1,
      "title": "Caption Max Words",
      "type": "integer"
    },
    "caption_mode": {
      "enum": [
        "phrase_active_word",
        "phrase_whole_run"
      ],
      "title": "Caption Mode",
      "type": "string"
    },
    "caption_y": {
      "maximum": 1700,
      "minimum": 300,
      "title": "Caption Y",
      "type": "integer"
    },
    "contrast": {
      "enum": [
        "legacy",
        "outline_shadow_backplate",
        "soft_backplate",
        "minimal_outline"
      ],
      "title": "Contrast",
      "type": "string"
    },
    "easing": {
      "enum": [
        "linear",
        "ease_out_cubic",
        "ease_in_out_cubic"
      ],
      "title": "Easing",
      "type": "string"
    },
    "enter_frames": {
      "maximum": 30,
      "minimum": 0,
      "title": "Enter Frames",
      "type": "integer"
    },
    "exit_frames": {
      "maximum": 30,
      "minimum": 0,
      "title": "Exit Frames",
      "type": "integer"
    },
    "font_identity": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Font Identity",
      "type": "string"
    },
    "font_sha256": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "title": "Font Sha256",
      "type": "array"
    },
    "max_scale_permille": {
      "maximum": 1100,
      "minimum": 1000,
      "title": "Max Scale Permille",
      "type": "integer"
    },
    "max_simultaneous_emphasis": {
      "maximum": 2,
      "minimum": 0,
      "title": "Max Simultaneous Emphasis",
      "type": "integer"
    },
    "max_travel_px": {
      "maximum": 80,
      "minimum": 0,
      "title": "Max Travel Px",
      "type": "integer"
    },
    "safe_bottom": {
      "maximum": 500,
      "minimum": 0,
      "title": "Safe Bottom",
      "type": "integer"
    },
    "safe_left": {
      "maximum": 300,
      "minimum": 0,
      "title": "Safe Left",
      "type": "integer"
    },
    "safe_right": {
      "maximum": 300,
      "minimum": 0,
      "title": "Safe Right",
      "type": "integer"
    },
    "safe_top": {
      "maximum": 400,
      "minimum": 0,
      "title": "Safe Top",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "style_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Style Id",
      "type": "string"
    }
  },
  "required": [
    "style_id",
    "easing",
    "enter_frames",
    "exit_frames",
    "max_travel_px",
    "max_scale_permille",
    "caption_mode",
    "contrast",
    "font_identity",
    "accent",
    "safe_left",
    "safe_right",
    "safe_top",
    "safe_bottom",
    "max_simultaneous_emphasis",
    "caption_max_words",
    "caption_max_chars",
    "caption_y"
  ],
  "title": "MotionStyleSpec",
  "type": "object"
}
