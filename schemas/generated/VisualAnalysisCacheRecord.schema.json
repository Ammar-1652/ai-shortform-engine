      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "tracking_profile_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Tracking Profile Fingerprint",
      "type": "string"
    },
    "validation_status": {
      "const": "passed",
      "title": "Validation Status",
      "type": "string"
