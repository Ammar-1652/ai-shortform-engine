{
  "additionalProperties": false,
  "description": "Sidecar for one published visual analysis. ``created_at`` is not identity.",
  "properties": {
    "analysis_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Analysis Artifact Sha256",
      "type": "string"
    },
    "analysis_artifact_size": {
      "minimum": 0,
      "title": "Analysis Artifact Size",
      "type": "integer"
    },
    "analysis_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Analysis Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_manifest_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Manifest Digest",
      "type": "string"
    },
    "face_model_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Face Model Sha256",
      "type": "string"
    },
    "face_profile_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Face Profile Fingerprint",
      "type": "string"
    },
    "job_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Job Id",
      "type": "string"
    },
    "mediapipe_version": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Mediapipe Version",
      "type": "string"
    },
    "opencv_version": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Opencv Version",
      "type": "string"
    },
    "project_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "proxy_recipe_name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Proxy Recipe Name",
      "type": "string"
    },
    "proxy_recipe_version": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Proxy Recipe Version",
      "type": "string"
    },
    "proxy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proxy Sha256",
      "type": "string"
    },
    "pyav_version": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Pyav Version",
      "type": "string"
    },
    "pyscenedetect_version": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Pyscenedetect Version",
      "type": "string"
    },
    "recipe_name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Recipe Name",
      "type": "string"
    },
    "recipe_version": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Recipe Version",
      "type": "string"
    },
    "sampling_profile_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sampling Profile Fingerprint",
      "type": "string"
    },
    "scene_backend": {
      "maxLength": 40,
      "minLength": 1,
