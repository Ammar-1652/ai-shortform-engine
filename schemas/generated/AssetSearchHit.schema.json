{
  "additionalProperties": false,
  "description": "Normalized provider metadata. Missing fields stay null.",
  "properties": {
    "asset_type": {
      "default": "unknown",
      "enum": [
        "video",
        "audio",
        "image",
        "graphic",
        "template",
        "font",
        "unknown"
      ],
      "title": "Asset Type",
      "type": "string"
    },
    "campaign_policy_decision": {
      "anyOf": [
        {
          "enum": [
            "allowed",
            "blocked",
            "needs_operator_confirmation",
            "needs_policy_clarification",
            "needs_operator_clarification",
            "rights_unverified",
            "unsupported_language",
            "unsupported_feature"
          ],
          "type": "string"
        },
        {
          "const": "pending",
          "type": "string"
        }
      ],
      "default": "pending",
      "title": "Campaign Policy Decision"
    },
    "category": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Category"
    },
    "commercial_use": {
      "default": "unknown",
      "enum": [
        "unknown",
        "allowed",
        "prohibited"
      ],
      "title": "Commercial Use",
      "type": "string"
    },
    "compatible_software": {
      "items": {
        "type": "string"
      },
      "title": "Compatible Software",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dimensions": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dimensions"
    },
    "direct_download_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Direct Download Url"
    },
    "download_status": {
      "default": "manual_download_required",
      "enum": [
        "manual_download_required",
        "acquired",
        "rejected"
      ],
      "title": "Download Status",
      "type": "string"
    },
    "duration_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Seconds"
    },
    "format": {
      "items": {
        "type": "string"
      },
      "title": "Format",
      "type": "array"
    },
    "frame_rate": {
      "anyOf": [
        {
          "maxLength": 20,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Frame Rate"
    },
    "genre": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Genre"
    },
    "item_id": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Item Id"
    },
    "item_url": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Item Url"
    },
    "license_evidence": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License Evidence"
    },
    "license_url": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License Url"
    },
    "local_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Local Path"
    },
    "metadata": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Metadata",
      "type": "object"
    },
    "operator_confirmation": {
      "default": false,
      "title": "Operator Confirmation",
      "type": "boolean"
    },
    "provider": {
      "enum": [
        "envato_mcp",
        "fake",
        "dry_run"
      ],
      "title": "Provider",
      "type": "string"
    },
    "rejection_reason": {
      "anyOf": [
        {
          "maxLength": 120,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejection Reason"
    },
    "request_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selection_status": {
      "default": "candidate",
      "enum": [
        "candidate",
        "selected",
        "rejected"
      ],
      "title": "Selection Status",
      "type": "string"
    },
    "sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sha256"
    },
    "style": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Style"
    },
    "title": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    }
  },
  "required": [
    "request_id",
    "provider",
    "created_at"
  ],
  "title": "AssetSearchHit",
  "type": "object"
}
