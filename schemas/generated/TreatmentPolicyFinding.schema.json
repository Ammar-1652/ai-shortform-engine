{
  "additionalProperties": false,
  "properties": {
    "code": {
      "pattern": "^[a-z][a-z0-9_.:-]{1,80}$",
      "title": "Code",
      "type": "string"
    },
    "message": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "required": [
    "severity",
    "code",
    "message"
  ],
  "title": "TreatmentPolicyFinding",
  "type": "object"
}
