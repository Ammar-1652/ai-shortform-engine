{
  "additionalProperties": false,
  "description": "One rendered Hero draft. Hashes point at files inside the Hero run.",
  "properties": {
    "alignment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Alignment Sha256",
      "type": "string"
    },
    "candidate_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "caption_count": {
      "minimum": 1,
      "title": "Caption Count",
      "type": "integer"
    },
    "detected_audio_codec": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Detected Audio Codec",
      "type": "string"
    },
    "detected_duration_us": {
      "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
      "maximum": 604800000000,
      "minimum": 0,
      "title": "Detected Duration Us",
      "type": "integer"
    },
    "detected_pixel_format": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Detected Pixel Format",
      "type": "string"
    },
    "detected_video_codec": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Detected Video Codec",
      "type": "string"
    },
    "duration_error_us": {
      "title": "Duration Error Us",
      "type": "integer"
    },
    "edit_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Edit Plan Sha256",
      "type": "string"
    },
    "height": {
      "const": 1920,
      "default": 1920,
      "title": "Height",
      "type": "integer"
    },
    "output_duration_us": {
      "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
      "maximum": 604800000000,
      "minimum": 0,
      "title": "Output Duration Us",
      "type": "integer"
    },
    "output_fps_denominator": {
      "const": 1,
      "default": 1,
      "title": "Output Fps Denominator",
      "type": "integer"
    },
    "output_fps_numerator": {
      "const": 30,
      "default": 30,
      "title": "Output Fps Numerator",
      "type": "integer"
    },
    "output_frame_count": {
      "minimum": 1,
      "title": "Output Frame Count",
      "type": "integer"
    },
    "preview_relative_path": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Preview Relative Path",
      "type": "string"
    },
    "preview_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Preview Sha256",
      "type": "string"
    },
    "preview_size_bytes": {
      "minimum": 1,
      "title": "Preview Size Bytes",
      "type": "integer"
    },
    "rank": {
      "minimum": 1,
      "title": "Rank",
      "type": "integer"
    },
    "render_input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Render Input Sha256",
      "type": "string"
    },
    "review_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Review Digest",
      "type": "string"
    },
    "review_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Review Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "time_map_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Time Map Sha256",
      "type": "string"
    },
    "width": {
      "const": 1080,
      "default": 1080,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "candidate_id",
    "rank",
    "review_id",
    "review_digest",
    "time_map_sha256",
    "alignment_sha256",
    "edit_plan_sha256",
    "render_input_sha256",
    "preview_relative_path",
    "preview_sha256",
    "preview_size_bytes",
    "output_duration_us",
    "output_frame_count",
    "caption_count",
    "detected_video_codec",
    "detected_pixel_format",
    "detected_audio_codec",
    "detected_duration_us",
    "duration_error_us"
  ],
  "title": "HeroDraftOutput",
  "type": "object"
}
