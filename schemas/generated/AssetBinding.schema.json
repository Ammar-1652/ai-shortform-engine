{
  "additionalProperties": false,
  "description": "Rights-cleared local asset used by one advanced plan. No filesystem path.",
  "properties": {
    "asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Asset Id",
      "type": "string"
    },
    "display_name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "kind": {
      "enum": [
        "graphic",
        "audio"
      ],
      "title": "Kind",
      "type": "string"
    },
    "license_record_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "License Record Id",
      "type": "string"
    },
    "license_status": {
      "enum": [
        "owned",
        "licensed",
        "campaign_provided"
      ],
      "title": "License Status",
      "type": "string"
    },
    "project_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "provenance_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Provenance Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    }
  },
  "required": [
    "asset_id",
    "project_id",
    "kind",
    "sha256",
    "license_record_id",
    "license_status",
    "provenance_sha256",
    "display_name"
  ],
  "title": "AssetBinding",
  "type": "object"
}
