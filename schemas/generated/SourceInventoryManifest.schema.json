{
  "$defs": {
    "CampaignSource": {
      "additionalProperties": false,
      "description": "One catalogued file. Folder membership is not rights evidence.",
      "properties": {
        "campaign_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Campaign Id",
          "type": "string"
        },
        "display_name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "download_status": {
          "enum": [
            "not_selected_for_round_18",
            "planned",
            "provider_unavailable",
            "acquired",
            "manual_download_required",
            "rejected"
          ],
          "title": "Download Status",
          "type": "string"
        },
        "mime_type": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Mime Type",
          "type": "string"
        },
        "priority": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Priority",
          "type": "string"
        },
        "provider": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "provider_file_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Provider File Id",
          "type": "string"
        },
        "rights_state": {
          "enum": [
            "allowed",
            "blocked",
            "needs_operator_confirmation",
            "needs_policy_clarification",
            "needs_operator_clarification",
            "rights_unverified",
            "unsupported_language",
            "unsupported_feature"
          ],
          "title": "Rights State",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_url": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "campaign_id",
        "provider",
        "provider_file_id",
        "display_name",
        "source_url",
        "mime_type",
        "size_bytes",
        "priority",
        "download_status",
        "rights_state"
      ],
      "title": "CampaignSource",
      "type": "object"
    },
    "PolicyDecision": {
      "additionalProperties": false,
      "description": "One append-only decision bound to a policy hash.",
      "properties": {
        "campaign_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Campaign Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decision": {
          "enum": [
            "allowed",
            "blocked",
            "needs_operator_confirmation",
            "needs_policy_clarification",
            "needs_operator_clarification",
            "rights_unverified",
            "unsupported_language",
            "unsupported_feature"
          ],
          "title": "Decision",
          "type": "string"
        },
        "decision_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Decision Id",
          "type": "string"
        },
        "evaluator_version": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Evaluator Version",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "human_confirmation": {
          "enum": [
            "unconfirmed",
            "confirmed",
            "not_required"
          ],
          "title": "Human Confirmation",
          "type": "string"
        },
        "implementation_mode": {
          "enum": [
            "external_black_box_ai_tool",
            "clipforge_native_editor",
            "human_supplied_asset",
            "voice_narration_provider"
          ],
          "title": "Implementation Mode",
          "type": "string"
        },
        "policy_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Policy Id",
          "type": "string"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "rule_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Rule Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "campaign_id",
        "policy_id",
        "policy_sha256",
        "rule_id",
        "decision",
        "implementation_mode",
        "evaluator_version",
        "human_confirmation",
        "created_at"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "SourceAcquisition": {
      "additionalProperties": false,
      "description": "One explicit acquisition. A plan is not a download.",
      "properties": {
        "acquired_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acquired At"
        },
        "acquisition_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Acquisition Id",
          "type": "string"
        },
        "campaign_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Campaign Id",
          "type": "string"
        },
        "download_status": {
          "enum": [
            "not_selected_for_round_18",
            "planned",
            "provider_unavailable",
            "acquired",
            "manual_download_required",
            "rejected"
          ],
          "title": "Download Status",
          "type": "string"
        },
        "error_code": {
          "default": "none",
          "maxLength": 80,
          "title": "Error Code",
          "type": "string"
        },
        "local_relative_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Relative Path"
        },
        "operator_confirmation": {
          "default": false,
          "title": "Operator Confirmation",
          "type": "boolean"
        },
        "probe_facts": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Probe Facts"
        },
        "provider": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "source_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        }
      },
      "required": [
        "acquisition_id",
        "campaign_id",
        "source_id",
        "provider",
        "download_status"
      ],
      "title": "SourceAcquisition",
      "type": "object"
    },
    "SourceRightsEvidence": {
      "additionalProperties": false,
      "description": "Why a source may be edited. A Drive folder listing is not enough.",
      "properties": {
        "campaign_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Campaign Id",
          "type": "string"
        },
        "evidence_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "evidence_kind": {
          "enum": [
            "campaign_guide",
            "operator_authorization"
          ],
          "title": "Evidence Kind",
          "type": "string"
        },
        "recorded_by": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Recorded By",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "statement": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "campaign_id",
        "source_id",
        "evidence_kind",
        "statement",
        "recorded_by"
      ],
      "title": "SourceRightsEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The catalogue for one campaign. Unselected files stay unselected.",
  "properties": {
    "acquisitions": {
      "items": {
        "$ref": "#/$defs/SourceAcquisition"
      },
      "title": "Acquisitions",
      "type": "array"
    },
    "campaign_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Campaign Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/PolicyDecision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "manifest_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Manifest Id",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "rights": {
      "items": {
        "$ref": "#/$defs/SourceRightsEvidence"
      },
      "title": "Rights",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/CampaignSource"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "manifest_id",
    "campaign_id",
    "policy_sha256",
    "sources",
    "created_at"
  ],
  "title": "SourceInventoryManifest",
  "type": "object"
}
