    "KnowledgeSource": {
      "additionalProperties": false,
      "description": "A pinned repository, page, policy, or authorized reference source.",
      "properties": {
        "allowed_uses": {
          "items": {
            "enum": [
              "analysis",
              "guidance",
              "code",
              "asset_reuse"
