{
  "$defs": {
    "OutputInterval": {
      "additionalProperties": false,
      "description": "An interval on the output timeline produced by the candidate's time map.",
      "properties": {
        "clock": {
          "const": "output",
          "default": "output",
          "title": "Clock",
          "type": "string"
        },
        "output_end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output End Us",
          "type": "integer"
        },
        "output_start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output Start Us",
          "type": "integer"
        }
      },
      "required": [
        "output_start_us",
        "output_end_us"
      ],
      "title": "OutputInterval",
      "type": "object"
    },
    "TreatmentRegion": {
      "additionalProperties": false,
      "description": "One output-space protected region used by treatment collision checks.",
      "properties": {
        "analyzer_version": {
          "default": "geometry-v1",
          "maxLength": 80,
          "minLength": 1,
          "title": "Analyzer Version",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "geometry_dependency_sha256": {
          "default": "",
          "pattern": "^$|^[0-9a-f]{64}$",
          "title": "Geometry Dependency Sha256",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1920,
          "title": "Height",
          "type": "integer"
        },
        "interval": {
          "$ref": "#/$defs/OutputInterval"
        },
        "region_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Region Id",
          "type": "string"
        },
        "role": {
          "enum": [
            "face",
            "active_subject",
            "source_text",
            "caption",
            "logo",
            "cta",
            "platform_safe",
            "platform_rail",
            "broll",
            "motion_graphic"
          ],
          "title": "Role",
          "type": "string"
        },
        "sample_frame_sha256s": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Sample Frame Sha256S",
          "type": "array"
        },
        "sample_timestamps_us": {
          "items": {
            "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
            "maximum": 604800000000,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 8,
          "title": "Sample Timestamps Us",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "enum": [
            "visual_analysis",
            "platform_profile",
            "render_input"
          ],
          "title": "Source",
          "type": "string"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1080,
          "title": "Width",
          "type": "integer"
        },
        "x": {
          "maximum": 1080,
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "maximum": 1920,
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "region_id",
        "role",
        "interval",
        "x",
        "y",
        "width",
        "height",
        "source"
      ],
      "title": "TreatmentRegion",
      "type": "object"
    },
    "TreatmentRoleEvidence": {
      "additionalProperties": false,
      "description": "Explicit presence/absence state for every protected visual role.",
      "properties": {
        "analyzer_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Analyzer Version",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Evidence Ids",
          "type": "array"
        },
        "note": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "region_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Region Ids",
          "type": "array"
        },
        "role": {
          "enum": [
            "face",
            "active_subject",
            "source_text",
            "caption",
            "logo",
            "cta",
            "platform_safe",
            "platform_rail",
            "broll",
            "motion_graphic"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "present",
            "absent_reviewed",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "role",
        "status",
        "analyzer_version",
        "note"
      ],
      "title": "TreatmentRoleEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Measured visual and collision facts for one treatment decision.",
  "properties": {
    "collision_status": {
      "default": "unknown",
      "enum": [
        "clear",
        "blocked",
        "unknown"
      ],
      "title": "Collision Status",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Evidence Ids",
      "type": "array"
    },
    "note": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Note",
      "type": "string"
    },
    "protected_region_ids": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Protected Region Ids",
      "type": "array"
    },
    "regions": {
      "items": {
        "$ref": "#/$defs/TreatmentRegion"
      },
      "maxItems": 32,
      "title": "Regions",
      "type": "array"
    },
    "relevance_score": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relevance Score"
    },
    "relevance_status": {
      "default": "unknown",
      "enum": [
        "related",
        "unrelated",
        "unknown"
      ],
      "title": "Relevance Status",
      "type": "string"
    },
    "relevance_threshold": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Relevance Threshold"
    },
    "role_evidence": {
      "items": {
        "$ref": "#/$defs/TreatmentRoleEvidence"
      },
      "maxItems": 16,
      "title": "Role Evidence",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "visual_scene_ids": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Visual Scene Ids",
      "type": "array"
    }
  },
  "required": [
    "note"
  ],
  "title": "TreatmentVisualEvidence",
  "type": "object"
}
