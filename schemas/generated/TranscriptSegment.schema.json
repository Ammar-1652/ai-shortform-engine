{
  "$defs": {
    "TranscriptWord": {
      "additionalProperties": false,
      "description": "One word on the source clock. ``clock`` cannot be switched to output time.",
      "properties": {
        "clock": {
          "const": "source",
          "default": "source",
          "title": "Clock",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "End Us",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Start Us",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "word_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Word Id",
          "type": "string"
        }
      },
      "required": [
        "word_id",
        "text",
        "start_us",
        "end_us"
      ],
      "title": "TranscriptWord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A source-clock transcript span. Words must sit inside the span.",
  "properties": {
    "clock": {
      "const": "source",
      "default": "source",
      "title": "Clock",
      "type": "string"
    },
    "end_us": {
      "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
      "maximum": 604800000000,
      "minimum": 0,
      "title": "End Us",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "segment_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Segment Id",
      "type": "string"
    },
    "start_us": {
      "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
      "maximum": 604800000000,
      "minimum": 0,
      "title": "Start Us",
      "type": "integer"
    },
    "text": {
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "words": {
      "items": {
        "$ref": "#/$defs/TranscriptWord"
      },
      "title": "Words",
      "type": "array"
    }
  },
  "required": [
    "segment_id",
    "start_us",
    "end_us",
    "text"
  ],
  "title": "TranscriptSegment",
  "type": "object"
}
