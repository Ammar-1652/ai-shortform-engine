{
  "additionalProperties": false,
  "properties": {
    "relative_path": {
      "pattern": "^editorial/treatment-observations/[A-Za-z0-9._:/-]+\\.jpg$",
      "title": "Relative Path",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "timestamp_us": {
      "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
      "maximum": 604800000000,
      "minimum": 0,
      "title": "Timestamp Us",
      "type": "integer"
    }
  },
  "required": [
    "relative_path",
    "sha256",
    "timestamp_us"
  ],
  "title": "TreatmentObservationFrame",
  "type": "object"
}
