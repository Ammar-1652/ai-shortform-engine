{
  "$defs": {
    "ArtifactProvenance": {
      "additionalProperties": false,
      "description": "Required lineage for stored media decisions and derived artifacts.\n\n``source_asset_ids`` is empty only for records that are not derived from a\nsource video (for example a newly created project). Derived media must list\nthe source.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "inputs_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs Sha256"
        },
        "job_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "parent_artifact_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_asset_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Source Asset Ids",
          "type": "array"
        },
        "tool": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "tool",
        "tool_version"
      ],
      "title": "ArtifactProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Measured narration audio. The file path and the waveform are not stored.",
  "properties": {
    "advanced_plan_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Advanced Plan Id"
    },
    "artifact_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "audio_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Audio Sha256",
      "type": "string"
    },
    "cache_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cache Id",
      "type": "string"
    },
    "channels": {
      "maximum": 2,
      "minimum": 1,
      "title": "Channels",
      "type": "integer"
    },
    "codec": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Codec",
      "type": "string"
    },
    "consent_record_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Consent Record Id",
      "type": "string"
    },
    "duration_us": {
      "exclusiveMinimum": 0,
      "title": "Duration Us",
      "type": "integer"
    },
    "engine_id": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Engine Id",
      "type": "string"
    },
    "hero_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hero Id"
    },
    "job_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Job Id",
      "type": "string"
    },
    "license_evidence_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "License Evidence Id",
      "type": "string"
    },
    "model_id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "model_revision": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Model Revision",
      "type": "string"
    },
    "project_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/ArtifactProvenance"
    },
    "provider_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Provider Id",
      "type": "string"
    },
    "sample_rate": {
      "maximum": 96000,
      "minimum": 8000,
      "title": "Sample Rate",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "script_label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Script Label",
      "type": "string"
    },
    "script_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Script Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 1,
      "title": "Size Bytes",
      "type": "integer"
    },
    "source_asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Asset Id",
      "type": "string"
    },
    "voice_profile_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Voice Profile Id",
      "type": "string"
    }
  },
  "required": [
    "artifact_id",
    "project_id",
    "source_asset_id",
    "provider_id",
    "voice_profile_id",
    "engine_id",
    "model_id",
    "model_revision",
    "script_sha256",
    "script_label",
    "audio_sha256",
    "size_bytes",
    "duration_us",
    "sample_rate",
    "channels",
    "codec",
    "consent_record_id",
    "license_evidence_id",
    "cache_id",
    "job_id",
    "provenance"
  ],
  "title": "NarrationAudioArtifact",
  "type": "object"
}
