{
  "$defs": {
    "ArtifactProvenance": {
      "additionalProperties": false,
      "description": "Required lineage for stored media decisions and derived artifacts.\n\n``source_asset_ids`` is empty only for records that are not derived from a\nsource video (for example a newly created project). Derived media must list\nthe source.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "inputs_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs Sha256"
        },
        "job_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "parent_artifact_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_asset_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Source Asset Ids",
          "type": "array"
        },
        "tool": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "tool",
        "tool_version"
      ],
      "title": "ArtifactProvenance",
      "type": "object"
    },
    "SpeechVerification": {
      "additionalProperties": false,
      "description": "Codex evidence for text that must not be guessed.",
      "properties": {
        "note": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_sha256": {
          "default": "",
          "pattern": "^$|^[0-9a-f]{64}$",
          "title": "Snapshot Sha256",
          "type": "string"
        },
        "source_url": {
          "default": "",
          "maxLength": 500,
          "title": "Source Url",
          "type": "string"
        },
        "status": {
          "const": "verified",
          "default": "verified",
          "title": "Status",
          "type": "string"
        },
        "subject_kind": {
          "enum": [
            "quran",
            "quotation",
            "proper_noun",
            "number",
            "factual_claim"
          ],
          "title": "Subject Kind",
          "type": "string"
        },
        "verification_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Verification Id",
          "type": "string"
        }
      },
      "required": [
        "verification_id",
        "subject_kind",
        "note"
      ],
      "title": "SpeechVerification",
      "type": "object"
    },
    "TarteelSpeechInterval": {
      "additionalProperties": false,
      "description": "Reviewed inventory of audible source material for caption coverage.",
      "properties": {
        "caption_decision": {
          "enum": [
            "captioned",
            "reviewed_excluded"
          ],
          "title": "Caption Decision",
          "type": "string"
        },
        "kind": {
          "enum": [
            "dialogue",
            "recitation",
            "reaction",
            "nasheed",
            "silence",
            "uncertain"
          ],
          "title": "Kind",
          "type": "string"
        },
        "observed_text": {
          "default": "",
          "title": "Observed Text",
          "type": "string"
        },
        "review_note": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Review Note",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Source End Us",
          "type": "integer"
        },
        "source_start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Source Start Us",
          "type": "integer"
        },
        "span_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Span Id",
          "type": "string"
        }
      },
      "required": [
        "span_id",
        "source_start_us",
        "source_end_us",
        "kind",
        "caption_decision",
        "review_note"
      ],
      "title": "TarteelSpeechInterval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Codex-reviewed source speech inventory used to upgrade caption coverage.\n\nThe historical class name is retained for stored Tarteel documents. The\nsame source-bound contract is also valid for generic campaigns when\n``campaign=\"generic\"`` and ``reviewer_role=\"codex_operator\"``.",
  "properties": {
    "campaign": {
      "enum": [
        "tarteel",
        "generic"
      ],
      "title": "Campaign",
      "type": "string"
    },
    "candidate_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "intervals": {
      "items": {
        "$ref": "#/$defs/TarteelSpeechInterval"
      },
      "minItems": 1,
      "title": "Intervals",
      "type": "array"
    },
    "locale": {
      "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$",
      "title": "Locale",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/ArtifactProvenance"
    },
    "raw_asr_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Asr Sha256",
      "type": "string"
    },
    "review_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Review Id",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "reviewer": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Reviewer",
      "type": "string"
    },
    "reviewer_role": {
      "anyOf": [
        {
          "enum": [
            "codex_operator",
            "human_reviewer"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer Role"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Asset Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "transcript_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Transcript Sha256",
      "type": "string"
    },
    "verifications": {
      "items": {
        "$ref": "#/$defs/SpeechVerification"
      },
      "maxItems": 32,
      "title": "Verifications",
      "type": "array"
    }
  },
  "required": [
    "review_id",
    "campaign",
    "source_asset_id",
    "candidate_id",
    "source_sha256",
    "raw_asr_sha256",
    "transcript_sha256",
    "locale",
    "intervals",
    "reviewer",
    "reviewed_at",
    "provenance"
  ],
  "title": "TarteelSpeechReview",
  "type": "object"
}
