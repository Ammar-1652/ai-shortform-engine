      "const": 3000000,
      "default": 3000000,
      "title": "Max Caption Duration Us",
      "type": "integer"
    },
    "max_caption_gap_us": {
      "const": 1250000,
      "default": 1250000,
      "title": "Max Caption Gap Us",
      "type": "integer"
    },
    "max_caption_words": {
      "const": 8,
      "default": 8,
