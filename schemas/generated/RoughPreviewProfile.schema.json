      "const": true,
      "default": true,
      "title": "Audio Enabled",
      "type": "boolean"
    },
    "background": {
      "default": "neutral-dark-v1",
      "enum": [
        "neutral-dark-v1",
        "blurred-source-v1"
      ],
      "title": "Background",
      "type": "string"
    },
    "campaign_id": {
      "default": "none",
      "enum": [
        "none",
        "tarteel"
      ],
      "title": "Campaign Id",
      "type": "string"
