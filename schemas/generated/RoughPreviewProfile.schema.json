    "video_codec": {
      "const": "h264",
      "default": "h264",
      "title": "Video Codec",
      "type": "string"
    },
    "video_fit": {
      "const": "contain",
      "default": "contain",
      "title": "Video Fit",
      "type": "string"
    },
    "width": {
      "const": 720,
