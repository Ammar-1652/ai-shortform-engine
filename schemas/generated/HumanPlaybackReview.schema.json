{
  "$defs": {
    "HumanWatchRecord": {
      "additionalProperties": false,
      "description": "A separate human playback observation; automation cannot create approval.",
      "properties": {
        "decision": {
          "enum": [
            "needs_changes",
            "reviewed_pending_final",
            "accepted_for_final_review"
          ],
          "title": "Decision",
          "type": "string"
        },
        "observations": {
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "minItems": 1,
          "title": "Observations",
          "type": "array"
        },
        "player": {
          "default": "",
          "maxLength": 200,
          "title": "Player",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "watched_muted": {
          "title": "Watched Muted",
          "type": "boolean"
        },
        "watched_with_audio": {
          "title": "Watched With Audio",
          "type": "boolean"
        }
      },
      "required": [
        "reviewer",
        "watched_with_audio",
        "watched_muted",
        "observations",
        "decision",
        "reviewed_at"
      ],
      "title": "HumanWatchRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Human observation stored with a final decision, never in immutable render bytes.",
  "properties": {
    "advanced_artifact_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Advanced Artifact Id",
      "type": "string"
    },
    "advanced_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Advanced Manifest Sha256",
      "type": "string"
    },
    "advanced_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Advanced Plan Sha256",
      "type": "string"
    },
    "automated": {
      "const": false,
      "title": "Automated",
      "type": "boolean"
    },
    "candidate_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "project_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "reviewer_role": {
      "const": "human_reviewer",
      "default": "human_reviewer",
      "title": "Reviewer Role",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Asset Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "video_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Video Sha256",
      "type": "string"
    },
    "watch": {
      "$ref": "#/$defs/HumanWatchRecord"
    }
  },
  "required": [
    "project_id",
    "source_asset_id",
    "candidate_id",
    "advanced_artifact_id",
    "advanced_manifest_sha256",
    "advanced_plan_sha256",
    "source_sha256",
    "video_sha256",
    "watch",
    "automated"
  ],
  "title": "HumanPlaybackReview",
  "type": "object"
}
