{
  "$defs": {
    "PublishFile": {
      "additionalProperties": false,
      "description": "One file inside a delivery package. The path is relative to the work root.",
      "properties": {
        "relative_path": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "video",
            "metadata",
            "captions_srt",
            "captions_vtt",
            "narration",
            "checksums",
            "manifest"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "size_bytes",
        "role"
      ],
      "title": "PublishFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The portable manifest for one local delivery. It stores hashes, not absolute paths.",
  "properties": {
    "advanced_artifact_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Advanced Artifact Id",
      "type": "string"
    },
    "advanced_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Advanced Artifact Sha256",
      "type": "string"
    },
    "advanced_artifact_size_bytes": {
      "minimum": 1,
      "title": "Advanced Artifact Size Bytes",
      "type": "integer"
    },
    "advanced_plan_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Advanced Plan Id",
      "type": "string"
    },
    "advanced_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Advanced Plan Sha256",
      "type": "string"
    },
    "advanced_set_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Advanced Set Id",
      "type": "string"
    },
    "advanced_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Advanced Set Sha256",
      "type": "string"
    },
    "alignment_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Alignment Id"
    },
    "alignment_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Alignment Sha256"
    },
    "approval_review_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Approval Review Id",
      "type": "string"
    },
    "audio_loudness_lufs": {
      "default": -16,
      "title": "Audio Loudness Lufs",
      "type": "number"
    },
    "audio_lra_lu": {
      "default": 11,
      "title": "Audio Lra Lu",
      "type": "number"
    },
    "audio_mix_version": {
      "const": "advanced-audio-mix-v1",
      "default": "advanced-audio-mix-v1",
      "title": "Audio Mix Version",
      "type": "string"
    },
    "audio_true_peak_dbfs": {
      "default": -1.5,
      "title": "Audio True Peak Dbfs",
      "type": "number"
    },
    "cache_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cache Fingerprint",
      "type": "string"
    },
    "candidate_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_rank": {
      "minimum": 1,
      "title": "Candidate Rank",
      "type": "integer"
    },
    "candidate_set_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Candidate Set Id",
      "type": "string"
    },
    "candidate_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Set Sha256",
      "type": "string"
    },
    "caption_mode": {
      "enum": [
        "authoritative",
        "embedded_or_unavailable"
      ],
      "title": "Caption Mode",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "delivery_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Delivery Id",
      "type": "string"
    },
    "delivery_status": {
      "const": "succeeded",
      "default": "succeeded",
      "title": "Delivery Status",
      "type": "string"
    },
    "destination": {
      "const": "local",
      "default": "local",
      "title": "Destination",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/PublishFile"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "profile_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Fingerprint",
      "type": "string"
    },
    "profile_id": {
      "const": "local-delivery-v1",
      "default": "local-delivery-v1",
      "title": "Profile Id",
      "type": "string"
    },
    "project_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "qa_set_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Qa Set Id",
      "type": "string"
    },
    "qa_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Qa Set Sha256",
      "type": "string"
    },
    "reframing_strategy": {
      "default": "contain",
      "maxLength": 40,
      "minLength": 1,
      "title": "Reframing Strategy",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Asset Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    }
  },
  "required": [
    "delivery_id",
    "project_id",
    "source_asset_id",
    "source_sha256",
    "candidate_id",
    "candidate_rank",
    "candidate_set_id",
    "candidate_set_sha256",
    "advanced_set_id",
    "advanced_set_sha256",
    "advanced_artifact_id",
    "advanced_artifact_sha256",
    "advanced_artifact_size_bytes",
    "advanced_plan_id",
    "advanced_plan_sha256",
    "qa_set_id",
    "qa_set_sha256",
    "approval_review_id",
    "profile_fingerprint",
    "caption_mode",
    "cache_fingerprint",
    "files",
    "created_at"
  ],
  "title": "PublishPackageDocument",
  "type": "object"
}
