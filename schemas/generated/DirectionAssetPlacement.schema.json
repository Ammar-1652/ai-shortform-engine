{
  "$defs": {
    "MotionPurpose": {
      "enum": [
        "number",
        "comparison",
        "product_feature",
        "process_step",
        "concept",
        "visual_reveal",
        "key_phrase",
        "data",
        "ui_interaction"
      ],
      "title": "MotionPurpose",
      "type": "string"
    },
    "OutputInterval": {
      "additionalProperties": false,
      "description": "An interval on the output timeline produced by the candidate's time map.",
      "properties": {
        "clock": {
          "const": "output",
          "default": "output",
          "title": "Clock",
          "type": "string"
        },
        "output_end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output End Us",
          "type": "integer"
        },
        "output_start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output Start Us",
          "type": "integer"
        }
      },
      "required": [
        "output_start_us",
        "output_end_us"
      ],
      "title": "OutputInterval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A reviewed, source-grounded placement for one local asset.\n\nAsset timing is never inferred from the number of assets. The selected\noption must name the exact output interval, the source evidence that makes\nthe asset relevant, and a plain-language editorial reason. The renderer\nconsumes this declarative record; it cannot execute operator code.",
  "properties": {
    "acquisition_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acquisition Id"
    },
    "asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Asset Id",
      "type": "string"
    },
    "asset_status": {
      "default": "acquired",
      "enum": [
        "pending",
        "selected",
        "acquired",
        "blocked",
        "unavailable"
      ],
      "title": "Asset Status",
      "type": "string"
    },
    "asset_tags": {
      "items": {
        "type": "string"
      },
      "maxItems": 24,
      "title": "Asset Tags",
      "type": "array"
    },
    "gain_db": {
      "anyOf": [
        {
          "maximum": 6,
          "minimum": -24,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gain Db"
    },
    "interval": {
      "$ref": "#/$defs/OutputInterval"
    },
    "kind": {
      "enum": [
        "graphic",
        "audio"
      ],
      "title": "Kind",
      "type": "string"
    },
    "license_evidence_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License Evidence Sha256"
    },
    "observation_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observation Id"
    },
    "observation_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observation Sha256"
    },
    "placement_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Placement Id",
      "type": "string"
    },
    "provider_response_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Response Sha256"
    },
    "purpose": {
      "$ref": "#/$defs/MotionPurpose"
    },
    "registered_asset_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Registered Asset Sha256"
    },
    "relevance_note": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Relevance Note",
      "type": "string"
    },
    "request_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Request Id"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selection_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selection Id"
    },
    "source_evidence_ids": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Evidence Ids",
      "type": "array"
    },
    "source_in_us": {
      "default": 0,
      "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
      "maximum": 604800000000,
      "minimum": 0,
      "title": "Source In Us",
      "type": "integer"
    }
  },
  "required": [
    "placement_id",
    "asset_id",
    "kind",
    "interval",
    "source_evidence_ids",
    "purpose",
    "relevance_note"
  ],
  "title": "DirectionAssetPlacement",
  "type": "object"
}
