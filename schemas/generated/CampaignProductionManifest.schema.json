{
  "$defs": {
    "CampaignProductionCacheRecord": {
      "additionalProperties": false,
      "description": "Identity of one aggregate. A hit still revalidates the pipeline evidence.",
      "properties": {
        "cache_key": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cache Key",
          "type": "string"
        },
        "catalogue_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Catalogue Fingerprint",
          "type": "string"
        },
        "hit": {
          "title": "Hit",
          "type": "boolean"
        },
        "pipeline_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pipeline Fingerprint",
          "type": "string"
        },
        "policy_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Fingerprint",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Selection Sha256",
          "type": "string"
        }
      },
      "required": [
        "cache_key",
        "pipeline_fingerprint",
        "selection_sha256",
        "policy_fingerprint",
        "catalogue_fingerprint",
        "hit"
      ],
      "title": "CampaignProductionCacheRecord",
      "type": "object"
    },
    "CampaignProductionSource": {
      "additionalProperties": false,
      "description": "Evidence for one selected source inside an aggregate production.",
      "properties": {
        "acquisition_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acquisition Id"
        },
        "acquisition_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acquisition Sha256"
        },
        "advanced_artifact_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Advanced Artifact Id"
        },
        "alignment_status": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Alignment Status",
          "type": "string"
        },
        "analytics_snapshot_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analytics Snapshot Id"
        },
        "analytics_status": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Analytics Status",
          "type": "string"
        },
        "byte_size": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Size"
        },
        "cache_status": {
          "enum": [
            "hit",
            "miss",
            "mixed"
          ],
          "title": "Cache Status",
          "type": "string"
        },
        "candidate_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Id"
        },
        "delivery_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Id"
        },
        "delivery_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Manifest Sha256"
        },
        "delivery_relative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Relative"
        },
        "failure_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        },
        "final_media_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final Media Sha256"
        },
        "hero_artifact_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hero Artifact Id"
        },
        "hero_review_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hero Review Id"
        },
        "narration_artifact_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narration Artifact Id"
        },
        "narration_audio_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narration Audio Sha256"
        },
        "narration_status": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Narration Status",
          "type": "string"
        },
        "qa_set_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qa Set Id"
        },
        "reframe_applied": {
          "default": "contain",
          "title": "Reframe Applied",
          "type": "string"
        },
        "reframe_blocker": {
          "default": "none",
          "title": "Reframe Blocker",
          "type": "string"
        },
        "reframe_cache_hit": {
          "default": false,
          "title": "Reframe Cache Hit",
          "type": "boolean"
        },
        "reframe_evidence_sha256": {
          "default": "none",
          "title": "Reframe Evidence Sha256",
          "type": "string"
        },
        "reframe_plan_id": {
          "default": "none",
          "title": "Reframe Plan Id",
          "type": "string"
        },
        "reframe_requested": {
          "default": "contain",
          "title": "Reframe Requested",
          "type": "string"
        },
        "reframe_status": {
          "default": "succeeded",
          "title": "Reframe Status",
          "type": "string"
        },
        "reframe_trajectory_sha256": {
          "default": "none",
          "title": "Reframe Trajectory Sha256",
          "type": "string"
        },
        "review_decision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Decision"
        },
        "review_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Id"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/CampaignProductionStageFact"
          },
          "title": "Stages",
          "type": "array"
        },
        "status": {
          "enum": [
            "succeeded",
            "partial",
            "failed",
            "blocked",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_sha256",
        "status",
        "cache_status",
        "analytics_status",
        "alignment_status",
        "narration_status",
        "stages"
      ],
      "title": "CampaignProductionSource",
      "type": "object"
    },
    "CampaignProductionStageFact": {
      "additionalProperties": false,
      "description": "One pipeline stage copied from the existing campaign run.",
      "properties": {
        "cache_hit": {
          "title": "Cache Hit",
          "type": "boolean"
        },
        "reason_code": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "status",
        "cache_hit",
        "reason_code"
      ],
      "title": "CampaignProductionStageFact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One operator production. It points at the existing pipeline run.",
  "properties": {
    "cache": {
      "$ref": "#/$defs/CampaignProductionCacheRecord"
    },
    "campaign_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Campaign Id",
      "type": "string"
    },
    "catalogue_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Catalogue Fingerprint",
      "type": "string"
    },
    "completed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "engine_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Engine Id"
    },
    "language": {
      "maxLength": 16,
      "minLength": 2,
      "title": "Language",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Id"
    },
    "model_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Revision"
    },
    "narration_enabled": {
      "title": "Narration Enabled",
      "type": "boolean"
    },
    "operator_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Operator Id",
      "type": "string"
    },
    "pipeline_run_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Pipeline Run Id",
      "type": "string"
    },
    "policy_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Fingerprint",
      "type": "string"
    },
    "project_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "publishing": {
      "const": "deferred",
      "default": "deferred",
      "title": "Publishing",
      "type": "string"
    },
    "reason_code": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Reason Code",
      "type": "string"
    },
    "run_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selection_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Fingerprint",
      "type": "string"
    },
    "selection_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Selection Id",
      "type": "string"
    },
    "selection_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Sha256",
      "type": "string"
    },
    "source_ids": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Ids",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/CampaignProductionSource"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "status": {
      "enum": [
        "succeeded",
        "partial",
        "failed",
        "blocked",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "voice_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Voice Id"
    }
  },
  "required": [
    "run_id",
    "pipeline_run_id",
    "campaign_id",
    "project_id",
    "selection_id",
    "selection_sha256",
    "selection_fingerprint",
    "catalogue_fingerprint",
    "policy_fingerprint",
    "operator_id",
    "source_ids",
    "language",
    "narration_enabled",
    "sources",
    "cache",
    "status",
    "reason_code",
    "created_at",
    "manifest_sha256"
  ],
  "title": "CampaignProductionManifest",
  "type": "object"
}
