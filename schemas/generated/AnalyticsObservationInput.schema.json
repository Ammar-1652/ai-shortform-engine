{
  "$defs": {
    "HumanEvidence": {
      "additionalProperties": false,
      "description": "Manual time and a copied review decision. This does not approve anything.",
      "properties": {
        "approval_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval At"
        },
        "correction_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correction Seconds"
        },
        "editing_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Editing Seconds"
        },
        "planning_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planning Seconds"
        },
        "review_decision": {
          "anyOf": [
            {
              "enum": [
                "approved",
                "rejected",
                "changes_requested"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Decision"
        },
        "review_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Id"
        },
        "review_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Seconds"
        },
        "reviewer_id": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer Id"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "HumanEvidence",
      "type": "object"
    },
    "ManualLabels": {
      "additionalProperties": false,
      "description": "Labels a person typed. ``unknown`` means the person did not supply one.",
      "properties": {
        "audience_tag": {
          "default": "unknown",
          "title": "Audience Tag",
          "type": "string"
        },
        "cta": {
          "default": "unknown",
          "title": "Cta",
          "type": "string"
        },
        "format_tag": {
          "default": "unknown",
          "title": "Format Tag",
          "type": "string"
        },
        "hook_type": {
          "default": "unknown",
          "title": "Hook Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "topic_tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Topic Tags",
          "type": "array"
        }
      },
      "title": "ManualLabels",
      "type": "object"
    },
    "PerformanceMetrics": {
      "additionalProperties": false,
      "description": "Optional platform measurements. An absent field was not reported.",
      "properties": {
        "average_watch_time_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Watch Time Us"
        },
        "clicks": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clicks"
        },
        "comments": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comments"
        },
        "completion_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Count"
        },
        "completion_rate": {
          "anyOf": [
            {
              "pattern": "^(?:0(?:\\.[0-9]{1,6})?|1(?:\\.0{1,6})?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Rate"
        },
        "follows": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Follows"
        },
        "likes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Likes"
        },
        "paid_views": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paid Views"
        },
        "revenue_amount": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,4})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revenue Amount"
        },
        "revenue_currency": {
          "anyOf": [
            {
              "const": "USD",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revenue Currency"
        },
        "saves": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Saves"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "shares": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shares"
        },
        "total_watch_time_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Watch Time Us"
        },
        "unique_viewers": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unique Viewers"
        },
        "views": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Views"
        }
      },
      "title": "PerformanceMetrics",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One local import row. Unknown fields are rejected.",
  "properties": {
    "artifact_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_kind": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Artifact Kind",
      "type": "string"
    },
    "artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Artifact Sha256",
      "type": "string"
    },
    "campaign_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Campaign Id"
    },
    "candidate_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Id"
    },
    "candidate_media_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Media Sha256"
    },
    "created_by": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Created By",
      "type": "string"
    },
    "duration_us": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Us"
    },
    "geography": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Geography"
    },
    "human": {
      "$ref": "#/$defs/HumanEvidence"
    },
    "idempotency_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "labels": {
      "$ref": "#/$defs/ManualLabels"
    },
    "manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest Sha256"
    },
    "measurement_window": {
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$",
      "title": "Measurement Window",
      "type": "string"
    },
    "metrics": {
      "$ref": "#/$defs/PerformanceMetrics"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "outcome_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Outcome Id",
      "type": "string"
    },
    "platform": {
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "title": "Platform",
      "type": "string"
    },
    "platform_post_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Platform Post Id"
    },
    "project_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "published_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Published At"
    },
    "qa_artifact_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Qa Artifact Id"
    },
    "qa_policy": {
      "default": "not_required",
      "enum": [
        "not_required",
        "historical",
        "current"
      ],
      "title": "Qa Policy",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Asset Id",
      "type": "string"
    }
  },
  "required": [
    "outcome_id",
    "idempotency_key",
    "project_id",
    "source_asset_id",
    "artifact_id",
    "artifact_kind",
    "artifact_sha256",
    "platform",
    "observed_at",
    "measurement_window",
    "created_by"
  ],
  "title": "AnalyticsObservationInput",
  "type": "object"
}
