{
  "$defs": {
    "AdvancedHeroDraftOutput": {
      "additionalProperties": false,
      "description": "One rendered advanced draft.",
      "properties": {
        "advanced_plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Advanced Plan Sha256",
          "type": "string"
        },
        "alignment_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Alignment Id",
          "type": "string"
        },
        "alignment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Alignment Sha256",
          "type": "string"
        },
        "arabic_corrections_sha256": {
          "default": "",
          "pattern": "^$|^[0-9a-f]{64}$",
          "title": "Arabic Corrections Sha256",
          "type": "string"
        },
        "candidate_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "caption_alignment_sha256": {
          "default": "",
          "pattern": "^$|^[0-9a-f]{64}$",
          "title": "Caption Alignment Sha256",
          "type": "string"
        },
        "caption_coverage_relative_path": {
          "default": "",
          "maxLength": 512,
          "title": "Caption Coverage Relative Path",
          "type": "string"
        },
        "caption_coverage_sha256": {
          "default": "",
          "pattern": "^$|^[0-9a-f]{64}$",
          "title": "Caption Coverage Sha256",
          "type": "string"
        },
        "detected_audio_codec": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Detected Audio Codec",
          "type": "string"
        },
        "detected_audio_sample_rate": {
          "minimum": 1,
          "title": "Detected Audio Sample Rate",
          "type": "integer"
        },
        "detected_duration_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Detected Duration Us",
          "type": "integer"
        },
        "detected_pixel_format": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Detected Pixel Format",
          "type": "string"
        },
        "detected_video_codec": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Detected Video Codec",
          "type": "string"
        },
        "direction_id": {
          "default": "",
          "maxLength": 128,
          "title": "Direction Id",
          "type": "string"
        },
        "direction_sha256": {
          "default": "",
          "pattern": "^$|^[0-9a-f]{64}$",
          "title": "Direction Sha256",
          "type": "string"
        },
        "duration_error_us": {
          "title": "Duration Error Us",
          "type": "integer"
        },
        "editorial_arc_id": {
          "default": "",
          "maxLength": 128,
          "title": "Editorial Arc Id",
          "type": "string"
        },
        "editorial_arc_review_sha256": {
          "default": "",
          "pattern": "^$|^[0-9a-f]{64}$",
          "title": "Editorial Arc Review Sha256",
          "type": "string"
        },
        "editorial_arc_sha256": {
          "default": "",
          "pattern": "^$|^[0-9a-f]{64}$",
          "title": "Editorial Arc Sha256",
          "type": "string"
        },
        "height": {
          "const": 1920,
          "default": 1920,
          "title": "Height",
          "type": "integer"
        },
        "hero_plan_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Hero Plan Id",
          "type": "string"
        },
        "hero_plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hero Plan Sha256",
          "type": "string"
        },
        "hero_review_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Hero Review Digest",
          "type": "string"
        },
        "hero_review_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Hero Review Id",
          "type": "string"
        },
        "hero_review_status": {
          "default": "approved",
          "enum": [
            "approved",
            "pending"
          ],
          "title": "Hero Review Status",
          "type": "string"
        },
        "knowledge_context_id": {
          "default": "",
          "maxLength": 128,
          "title": "Knowledge Context Id",
          "type": "string"
        },
        "knowledge_context_sha256": {
          "default": "",
          "pattern": "^$|^[0-9a-f]{64}$",
          "title": "Knowledge Context Sha256",
          "type": "string"
        },
        "knowledge_decision_trace_id": {
          "default": "",
          "maxLength": 128,
          "title": "Knowledge Decision Trace Id",
          "type": "string"
        },
        "knowledge_decision_trace_sha256": {
          "default": "",
          "pattern": "^$|^[0-9a-f]{64}$",
          "title": "Knowledge Decision Trace Sha256",
          "type": "string"
        },
        "knowledge_release_id": {
          "default": "",
          "maxLength": 128,
          "title": "Knowledge Release Id",
          "type": "string"
        },
        "motion_catalog_sha256": {
          "default": "",
          "pattern": "^$|^[0-9a-f]{64}$",
          "title": "Motion Catalog Sha256",
          "type": "string"
        },
        "motion_recipe_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Motion Recipe Ids",
          "type": "array"
        },
        "output_duration_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output Duration Us",
          "type": "integer"
        },
        "output_fps_denominator": {
          "const": 1,
          "default": 1,
          "title": "Output Fps Denominator",
          "type": "integer"
        },
        "output_fps_numerator": {
          "const": 30,
          "default": 30,
          "title": "Output Fps Numerator",
          "type": "integer"
        },
        "overlay_exclusion_relative_path": {
          "default": "",
          "maxLength": 512,
          "title": "Overlay Exclusion Relative Path",
          "type": "string"
        },
        "overlay_exclusion_sha256": {
          "default": "",
          "pattern": "^$|^[0-9a-f]{64}$",
          "title": "Overlay Exclusion Sha256",
          "type": "string"
        },
        "pilot_sha256": {
          "default": "",
          "pattern": "^$|^[0-9a-f]{64}$",
          "title": "Pilot Sha256",
          "type": "string"
        },
        "preset_id": {
          "default": "",
          "maxLength": 64,
          "title": "Preset Id",
          "type": "string"
        },
        "preview_relative_path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Preview Relative Path",
          "type": "string"
        },
        "preview_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preview Sha256",
          "type": "string"
        },
        "preview_size_bytes": {
          "minimum": 1,
          "title": "Preview Size Bytes",
          "type": "integer"
        },
        "quran_review_id": {
          "default": "",
          "maxLength": 128,
          "title": "Quran Review Id",
          "type": "string"
        },
        "quran_review_sha256": {
          "default": "",
          "pattern": "^$|^[0-9a-f]{64}$",
          "title": "Quran Review Sha256",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "render_input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Render Input Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "speech_review_sha256": {
          "default": "",
          "pattern": "^$|^[0-9a-f]{64}$",
          "title": "Speech Review Sha256",
          "type": "string"
        },
        "style_id": {
          "default": "legacy-v1",
          "maxLength": 64,
          "minLength": 1,
          "title": "Style Id",
          "type": "string"
        },
        "treatment_audio_mix": {
          "anyOf": [
            {
              "$ref": "#/$defs/TreatmentAudioMixResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "treatment_fingerprint": {
          "default": "",
          "pattern": "^$|^[0-9a-f]{64}$",
          "title": "Treatment Fingerprint",
          "type": "string"
        },
        "viewer_evidence_relative_path": {
          "default": "",
          "maxLength": 512,
          "title": "Viewer Evidence Relative Path",
          "type": "string"
        },
        "viewer_evidence_sha256": {
          "default": "",
          "pattern": "^$|^[0-9a-f]{64}$",
          "title": "Viewer Evidence Sha256",
          "type": "string"
        },
        "width": {
          "const": 1080,
          "default": 1080,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "candidate_id",
        "rank",
        "hero_review_id",
        "hero_review_digest",
        "alignment_id",
        "alignment_sha256",
        "hero_plan_id",
        "hero_plan_sha256",
        "advanced_plan_sha256",
        "render_input_sha256",
        "preview_relative_path",
        "preview_sha256",
        "preview_size_bytes",
        "output_duration_us",
        "detected_video_codec",
        "detected_pixel_format",
        "detected_audio_codec",
        "detected_audio_sample_rate",
        "detected_duration_us",
        "duration_error_us"
      ],
      "title": "AdvancedHeroDraftOutput",
      "type": "object"
    },
    "AdvancedHeroProfile": {
      "additionalProperties": false,
      "description": "Output-changing advanced Hero settings. This is not hero-draft-v1.",
      "properties": {
        "audio_codec": {
          "const": "aac",
          "default": "aac",
          "title": "Audio Codec",
          "type": "string"
        },
        "audio_loudness_lufs": {
          "default": -16,
          "title": "Audio Loudness Lufs",
          "type": "number"
        },
        "audio_lra_lu": {
          "default": 11,
          "title": "Audio Lra Lu",
          "type": "number"
        },
        "audio_mix_version": {
          "const": "advanced-audio-mix-v1",
          "default": "advanced-audio-mix-v1",
          "title": "Audio Mix Version",
          "type": "string"
        },
        "audio_sample_rate": {
          "const": 48000,
          "default": 48000,
          "title": "Audio Sample Rate",
          "type": "integer"
        },
        "audio_true_peak_dbfs": {
          "default": -1.5,
          "title": "Audio True Peak Dbfs",
          "type": "number"
        },
        "background": {
          "const": "neutral-dark-v1",
          "default": "neutral-dark-v1",
          "title": "Background",
          "type": "string"
        },
        "broll_policy": {
          "const": "rights_cleared_local",
          "default": "rights_cleared_local",
          "title": "Broll Policy",
          "type": "string"
        },
        "caption_algorithm_version": {
          "default": "advanced-caption-clean-v1",
          "enum": [
            "advanced-caption-v1",
            "advanced-caption-clean-v1"
          ],
          "title": "Caption Algorithm Version",
          "type": "string"
        },
        "diagram_version": {
          "default": "advanced-diagram-grounded-v1",
          "enum": [
            "advanced-diagram-v1",
            "advanced-diagram-grounded-v1"
          ],
          "title": "Diagram Version",
          "type": "string"
        },
        "duration_tolerance_us": {
          "const": 100000,
          "default": 100000,
          "title": "Duration Tolerance Us",
          "type": "integer"
        },
        "fps_denominator": {
          "const": 1,
          "default": 1,
          "title": "Fps Denominator",
          "type": "integer"
        },
        "fps_numerator": {
          "const": 30,
          "default": 30,
          "title": "Fps Numerator",
          "type": "integer"
        },
        "height": {
          "const": 1920,
          "default": 1920,
          "title": "Height",
          "type": "integer"
        },
        "manual_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReframingWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "manual_windows": {
          "items": {
            "$ref": "#/$defs/ReframingWindow"
          },
          "title": "Manual Windows",
          "type": "array"
        },
        "max_broll_events": {
          "default": 4,
          "maximum": 8,
          "minimum": 0,
          "title": "Max Broll Events",
          "type": "integer"
        },
        "max_gain_db": {
          "const": 6,
          "default": 6,
          "title": "Max Gain Db",
          "type": "integer"
        },
        "max_sfx_events": {
          "default": 4,
          "maximum": 8,
          "minimum": 0,
          "title": "Max Sfx Events",
          "type": "integer"
        },
        "min_gain_db": {
          "const": -24,
          "default": -24,
          "title": "Min Gain Db",
          "type": "integer"
        },
        "motion_graphics_version": {
          "const": "advanced-motion-graphics-v1",
          "default": "advanced-motion-graphics-v1",
          "title": "Motion Graphics Version",
          "type": "string"
        },
        "motion_library_version": {
          "default": "advanced-motion-clean-v1",
          "enum": [
            "advanced-motion-v1",
            "advanced-motion-clean-v1"
          ],
          "title": "Motion Library Version",
          "type": "string"
        },
        "music_allowed": {
          "const": false,
          "default": false,
          "title": "Music Allowed",
          "type": "boolean"
        },
        "narration_duck_db": {
          "default": -12,
          "title": "Narration Duck Db",
          "type": "number"
        },
        "pixel_format": {
          "const": "yuv420p",
          "default": "yuv420p",
          "title": "Pixel Format",
          "type": "string"
        },
        "profile_id": {
          "const": "advanced-hero-v1",
          "default": "advanced-hero-v1",
          "title": "Profile Id",
          "type": "string"
        },
        "reframing": {
          "$ref": "#/$defs/ReframingStrategy"
        },
        "renderer_recipe_version": {
          "default": "advanced-hero-renderer-directed-v3",
          "enum": [
            "advanced-hero-renderer-v1",
            "advanced-hero-renderer-clean-v1",
            "advanced-hero-renderer-directed-v2",
            "advanced-hero-renderer-directed-v3",
            "advanced-hero-renderer-directed-v4"
          ],
          "title": "Renderer Recipe Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sfx_default_gain_db": {
          "default": -18,
          "maximum": 0,
          "minimum": -24,
          "title": "Sfx Default Gain Db",
          "type": "number"
        },
        "sfx_fade_in_us": {
          "default": 20000,
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Sfx Fade In Us",
          "type": "integer"
        },
        "sfx_fade_out_us": {
          "default": 60000,
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Sfx Fade Out Us",
          "type": "integer"
        },
        "sfx_max_gain_db": {
          "const": -18,
          "default": -18,
          "title": "Sfx Max Gain Db",
          "type": "integer"
        },
        "sfx_policy": {
          "const": "rights_cleared_local",
          "default": "rights_cleared_local",
          "title": "Sfx Policy",
          "type": "string"
        },
        "staging_recipe_version": {
          "default": "time-map-v2-frame-quantized",
          "enum": [
            "time-map-v1-audio-envelope",
            "time-map-v2-frame-quantized"
          ],
          "title": "Staging Recipe Version",
          "type": "string"
        },
        "typography_version": {
          "default": "advanced-typography-clean-v1",
          "enum": [
            "advanced-typography-v1",
            "advanced-typography-clean-v1"
          ],
          "title": "Typography Version",
          "type": "string"
        },
        "video_codec": {
          "const": "h264",
          "default": "h264",
          "title": "Video Codec",
          "type": "string"
        },
        "width": {
          "const": 1080,
          "default": 1080,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "reframing"
      ],
      "title": "AdvancedHeroProfile",
      "type": "object"
    },
    "ArtifactProvenance": {
      "additionalProperties": false,
      "description": "Required lineage for stored media decisions and derived artifacts.\n\n``source_asset_ids`` is empty only for records that are not derived from a\nsource video (for example a newly created project). Derived media must list\nthe source.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "inputs_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs Sha256"
        },
        "job_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "parent_artifact_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_asset_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Source Asset Ids",
          "type": "array"
        },
        "tool": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "tool",
        "tool_version"
      ],
      "title": "ArtifactProvenance",
      "type": "object"
    },
    "ReframingStrategy": {
      "additionalProperties": false,
      "description": "Named crop strategy. It does not identify a speaker.",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "strategy_id": {
          "enum": [
            "contain",
            "center_crop",
            "manual_window",
            "visual_safe_window",
            "multi_face_safe_window",
            "saliency_window",
            "face_follow"
          ],
          "title": "Strategy Id",
          "type": "string"
        }
      },
      "required": [
        "strategy_id"
      ],
      "title": "ReframingStrategy",
      "type": "object"
    },
    "ReframingWindow": {
      "additionalProperties": false,
      "description": "One crop on the visual frame. Coordinates are pixels inside that frame.",
      "properties": {
        "frame_height": {
          "minimum": 1,
          "title": "Frame Height",
          "type": "integer"
        },
        "frame_width": {
          "minimum": 1,
          "title": "Frame Width",
          "type": "integer"
        },
        "output_end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output End Us",
          "type": "integer"
        },
        "output_start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output Start Us",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_height": {
          "minimum": 1,
          "title": "Source Height",
          "type": "integer"
        },
        "source_width": {
          "minimum": 1,
          "title": "Source Width",
          "type": "integer"
        },
        "source_x": {
          "minimum": 0,
          "title": "Source X",
          "type": "integer"
        },
        "source_y": {
          "minimum": 0,
          "title": "Source Y",
          "type": "integer"
        },
        "strategy_id": {
          "$ref": "#/$defs/ReframingStrategy"
        },
        "window_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Window Id",
          "type": "string"
        }
      },
      "required": [
        "window_id",
        "strategy_id",
        "output_start_us",
        "output_end_us",
        "source_x",
        "source_y",
        "source_width",
        "source_height",
        "frame_width",
        "frame_height"
      ],
      "title": "ReframingWindow",
      "type": "object"
    },
    "TreatmentAudioMixResult": {
      "additionalProperties": false,
      "description": "Hash-bound requested/applied SFX mix policy and measured output facts.",
      "properties": {
        "applied_gain_db": {
          "items": {
            "type": "number"
          },
          "maxItems": 32,
          "title": "Applied Gain Db",
          "type": "array"
        },
        "cue_event_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
