{
  "additionalProperties": false,
  "description": "The operator's choice of one imported campaign. It is not a license.",
  "properties": {
    "campaign_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Campaign Id",
      "type": "string"
    },
    "catalogue_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Catalogue Fingerprint",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Fingerprint",
      "type": "string"
    },
    "evidence_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Evidence Id",
      "type": "string"
    },
    "import_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Import Id",
      "type": "string"
    },
    "language": {
      "maxLength": 16,
      "minLength": 2,
      "title": "Language",
      "type": "string"
    },
    "narration_request": {
      "enum": [
        "not_requested",
        "requested"
      ],
      "title": "Narration Request",
      "type": "string"
    },
    "operator_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Operator Id",
      "type": "string"
    },
    "policy_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Fingerprint",
      "type": "string"
    },
    "project_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "publishing": {
      "const": "deferred",
      "default": "deferred",
      "title": "Publishing",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_hashes": {
      "items": {
        "type": "string"
      },
      "title": "Source Hashes",
      "type": "array"
    },
    "source_ids": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Ids",
      "type": "array"
    },
    "whop_live": {
      "const": "not_configured",
      "default": "not_configured",
      "title": "Whop Live",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "campaign_id",
    "import_id",
    "project_id",
    "catalogue_fingerprint",
    "policy_fingerprint",
    "source_ids",
    "source_hashes",
    "language",
    "narration_request",
    "operator_id",
    "evidence_fingerprint",
    "created_at"
  ],
  "title": "WhopSelectionEvidence",
  "type": "object"
}
