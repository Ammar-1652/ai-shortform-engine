{
  "$defs": {
    "CampaignSourceBinding": {
      "additionalProperties": false,
      "description": "One source as the operator run handed it to the production runner.",
      "properties": {
        "acquisition_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acquisition Id"
        },
        "cache_status": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Cache Status",
          "type": "string"
        },
        "delivery_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Id"
        },
        "reason_code": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "status": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_sha256",
        "status",
        "cache_status",
        "reason_code"
      ],
      "title": "CampaignSourceBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Links one production run to the selection and acquisitions that authorized it.",
  "properties": {
    "campaign_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Campaign Id",
      "type": "string"
    },
    "campaign_run_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Campaign Run Id",
      "type": "string"
    },
    "catalogue_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Catalogue Fingerprint",
      "type": "string"
    },
    "language": {
      "maxLength": 16,
      "minLength": 2,
      "title": "Language",
      "type": "string"
    },
    "narration_enabled": {
      "title": "Narration Enabled",
      "type": "boolean"
    },
    "policy_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Fingerprint",
      "type": "string"
    },
    "publishing": {
      "const": "deferred",
      "default": "deferred",
      "title": "Publishing",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selection_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Fingerprint",
      "type": "string"
    },
    "selection_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Selection Id",
      "type": "string"
    },
    "selection_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Sha256",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/CampaignSourceBinding"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "campaign_run_id",
    "campaign_id",
    "selection_id",
    "selection_sha256",
    "selection_fingerprint",
    "policy_fingerprint",
    "catalogue_fingerprint",
    "language",
    "narration_enabled",
    "sources"
  ],
  "title": "CampaignOperatorBinding",
  "type": "object"
}
