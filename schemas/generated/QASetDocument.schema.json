{
  "$defs": {
    "ArtifactProvenance": {
      "additionalProperties": false,
      "description": "Required lineage for stored media decisions and derived artifacts.\n\n``source_asset_ids`` is empty only for records that are not derived from a\nsource video (for example a newly created project). Derived media must list\nthe source.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "inputs_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs Sha256"
        },
        "job_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "parent_artifact_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_asset_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Source Asset Ids",
          "type": "array"
        },
        "tool": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "tool",
        "tool_version"
      ],
      "title": "ArtifactProvenance",
      "type": "object"
    },
    "PolicyDigest": {
      "additionalProperties": false,
      "description": "One resolved policy and its canonical hash. The path is not stored.",
      "properties": {
        "policy_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Policy Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "sha256"
      ],
      "title": "PolicyDigest",
      "type": "object"
    },
    "QACheck": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/QAStatus"
        }
      },
      "required": [
        "name",
        "status",
        "evidence"
      ],
      "title": "QACheck",
      "type": "object"
    },
    "QAKind": {
      "enum": [
        "technical",
        "campaign_compliance"
      ],
      "title": "QAKind",
      "type": "string"
    },
    "QAResult": {
      "additionalProperties": false,
      "description": "Aggregated QA. The status must match the checks. A pass cannot hide a failure.",
      "properties": {
        "artifact_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/QACheck"
          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/QAKind"
        },
        "project_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Project Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/ArtifactProvenance"
        },
        "qa_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Qa Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/QAStatus"
        }
      },
      "required": [
        "qa_id",
        "project_id",
        "artifact_id",
        "kind",
        "status",
        "checks",
        "provenance"
      ],
      "title": "QAResult",
      "type": "object"
    },
    "QAStatus": {
      "enum": [
        "pass",
        "fail",
        "insufficient_evidence"
      ],
      "title": "QAStatus",
      "type": "string"
    },
    "WorkflowRolePolicy": {
      "additionalProperties": false,
      "description": "The responsibility split for one production run.\n\nCodex owns source-grounded editorial choices and orchestration. Clipforge\nowns deterministic media, provenance, rights, timing, cache, and QA gates.\nA person remains the only authority that can accept the final playback.",
      "properties": {
        "deterministic_enforcer": {
          "const": "system_enforcer",
          "default": "system_enforcer",
          "title": "Deterministic Enforcer",
          "type": "string"
        },
        "editorial_operator": {
          "const": "codex_operator",
          "default": "codex_operator",
          "title": "Editorial Operator",
          "type": "string"
        },
        "external_publishing": {
          "const": "deferred",
          "default": "deferred",
          "title": "External Publishing",
          "type": "string"
        },
        "final_playback_required": {
          "const": true,
          "default": true,
          "title": "Final Playback Required",
          "type": "boolean"
        },
        "final_reviewer": {
          "const": "human_reviewer",
          "default": "human_reviewer",
          "title": "Final Reviewer",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "WorkflowRolePolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Technical and campaign QA bound to one current artifact.",
  "properties": {
    "campaign": {
      "$ref": "#/$defs/QAResult"
    },
    "policies": {
      "items": {
        "$ref": "#/$defs/PolicyDigest"
      },
      "minItems": 1,
      "title": "Policies",
      "type": "array"
    },
    "profile_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Profile Id",
      "type": "string"
    },
    "profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Sha256",
      "type": "string"
    },
    "project_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/ArtifactProvenance"
    },
    "qa_set_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Qa Set Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Asset Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/QAStatus"
    },
    "target_artifact_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Target Artifact Id",
      "type": "string"
    },
    "target_artifact_kind": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Target Artifact Kind",
      "type": "string"
    },
    "target_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Manifest Sha256",
      "type": "string"
    },
    "technical": {
      "$ref": "#/$defs/QAResult"
    },
    "treatment_evidence_relative_path": {
      "default": "",
      "maxLength": 512,
      "title": "Treatment Evidence Relative Path",
      "type": "string"
    },
    "treatment_evidence_sha256": {
      "default": "",
      "pattern": "^$|^[0-9a-f]{64}$",
      "title": "Treatment Evidence Sha256",
      "type": "string"
    },
    "treatment_fingerprint": {
      "default": "",
      "pattern": "^$|^[0-9a-f]{64}$",
      "title": "Treatment Fingerprint",
      "type": "string"
    },
    "treatment_summary_sha256": {
      "default": "",
      "pattern": "^$|^[0-9a-f]{64}$",
      "title": "Treatment Summary Sha256",
      "type": "string"
    },
    "workflow_roles": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkflowRolePolicy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "qa_set_id",
    "project_id",
    "source_asset_id",
    "target_artifact_id",
    "target_artifact_kind",
    "target_manifest_sha256",
    "profile_id",
    "profile_sha256",
    "policies",
    "technical",
    "campaign",
    "status",
    "provenance"
  ],
  "title": "QASetDocument",
  "type": "object"
}
