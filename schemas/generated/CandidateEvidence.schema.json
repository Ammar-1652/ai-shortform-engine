{
  "$defs": {
    "EvidenceKind": {
      "enum": [
        "transcript",
        "visual",
        "audio",
        "campaign_fit",
        "human"
      ],
      "title": "EvidenceKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One reason a candidate exists. The kind says whether it is spoken, visual, or other.",
  "properties": {
    "detail": {
      "minLength": 1,
      "title": "Detail",
      "type": "string"
    },
    "evidence_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Evidence Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/EvidenceKind"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_end_us": {
      "anyOf": [
        {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source End Us"
    },
    "source_start_us": {
      "anyOf": [
        {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Start Us"
    }
  },
  "required": [
    "evidence_id",
    "kind",
    "detail"
  ],
  "title": "CandidateEvidence",
  "type": "object"
}
