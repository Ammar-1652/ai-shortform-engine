{
  "additionalProperties": false,
  "description": "Sidecar for the current advanced set.",
  "properties": {
    "advanced_input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Advanced Input Sha256",
      "type": "string"
    },
    "advanced_set_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Advanced Set Id",
      "type": "string"
    },
    "candidate_set_artifact_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Candidate Set Artifact Id",
      "type": "string"
    },
    "candidate_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Set Sha256",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "direction_sha256s": {
      "items": {
        "type": "string"
      },
      "title": "Direction Sha256S",
      "type": "array"
    },
    "hero_artifact_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Hero Artifact Id",
      "type": "string"
    },
    "hero_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hero Manifest Sha256",
      "type": "string"
    },
    "hero_review_status": {
      "default": "approved",
      "enum": [
        "approved",
        "pending"
      ],
      "title": "Hero Review Status",
      "type": "string"
    },
    "hero_set_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Hero Set Id",
      "type": "string"
    },
    "job_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Job Id",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "manifest_size_bytes": {
      "minimum": 1,
      "title": "Manifest Size Bytes",
      "type": "integer"
    },
    "profile_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Fingerprint",
      "type": "string"
    },
    "project_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "reframing_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Reframing Config Sha256",
      "type": "string"
    },
    "reframing_strategy": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Reframing Strategy",
      "type": "string"
    },
    "rendered_count": {
      "minimum": 1,
      "title": "Rendered Count",
      "type": "integer"
    },
    "renderer_dependency_sha256": {
      "default": "",
      "pattern": "^$|^[0-9a-f]{64}$",
      "title": "Renderer Dependency Sha256",
      "type": "string"
    },
    "rough_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rough Manifest Sha256",
      "type": "string"
    },
    "rough_preview_artifact_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Rough Preview Artifact Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Asset Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "validation_status": {
      "const": "passed",
      "title": "Validation Status",
      "type": "string"
    },
    "visual_analysis_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Visual Analysis Id",
      "type": "string"
    },
    "visual_analysis_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Visual Analysis Sha256",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "source_asset_id",
    "advanced_set_id",
    "job_id",
    "source_sha256",
    "candidate_set_artifact_id",
    "candidate_set_sha256",
    "rough_preview_artifact_id",
    "rough_manifest_sha256",
    "hero_artifact_id",
    "hero_set_id",
    "hero_manifest_sha256",
    "visual_analysis_id",
    "visual_analysis_sha256",
    "profile_fingerprint",
    "reframing_strategy",
    "reframing_config_sha256",
    "advanced_input_sha256",
    "manifest_sha256",
    "manifest_size_bytes",
    "rendered_count",
    "validation_status",
    "created_at"
  ],
  "title": "AdvancedHeroCacheRecord",
  "type": "object"
}
