{
  "$defs": {
    "CampaignOverlaySpec": {
      "additionalProperties": false,
      "description": "Source-bound branding required by a campaign delivery profile.\n\nThe renderer receives safe staging names only. Asset ids and hashes stay\nin the typed plan/catalogue, so an overlay cannot be swapped after QA.\nTarteel CTA clips are green-screen files; ``chroma_key_v1`` records that\nthe green background was removed before Remotion compositing.",
      "properties": {
        "campaign_id": {
          "const": "tarteel",
          "default": "tarteel",
          "title": "Campaign Id",
          "type": "string"
        },
        "cta_asset_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Cta Asset Id",
          "type": "string"
        },
        "cta_asset_name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Cta Asset Name",
          "type": "string"
        },
        "cta_asset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Cta Asset Sha256",
          "type": "string"
        },
        "cta_background_removal": {
          "const": "chroma_key_v1",
          "default": "chroma_key_v1",
          "title": "Cta Background Removal",
          "type": "string"
        },
        "cta_end_us": {
          "exclusiveMinimum": 0,
          "title": "Cta End Us",
          "type": "integer"
        },
        "cta_frame_count": {
          "maximum": 600,
          "minimum": 1,
          "title": "Cta Frame Count",
          "type": "integer"
        },
        "cta_frame_prefix": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Cta Frame Prefix",
          "type": "string"
        },
        "cta_frame_rate": {
          "const": 30,
          "default": 30,
          "title": "Cta Frame Rate",
          "type": "integer"
        },
        "cta_render_mode": {
          "const": "alpha_png_sequence_v1",
          "default": "alpha_png_sequence_v1",
          "title": "Cta Render Mode",
          "type": "string"
        },
        "cta_start_us": {
          "minimum": 0,
          "title": "Cta Start Us",
          "type": "integer"
        },
        "first_post_caption_line": {
          "const": "\u0627\u0634\u062a\u0631\u0643 \u0641\u064a \u0642\u0646\u0627\u0629 \u062a\u0631\u062a\u064a\u0644 \u0639\u0644\u0649 \u0627\u0644\u064a\u0648\u062a\u064a\u0648\u0628: @tarteelarabic",
          "default": "\u0627\u0634\u062a\u0631\u0643 \u0641\u064a \u0642\u0646\u0627\u0629 \u062a\u0631\u062a\u064a\u0644 \u0639\u0644\u0649 \u0627\u0644\u064a\u0648\u062a\u064a\u0648\u0628: @tarteelarabic",
          "title": "First Post Caption Line",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "watermark_asset_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Watermark Asset Id",
          "type": "string"
        },
        "watermark_asset_name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Watermark Asset Name",
          "type": "string"
        },
        "watermark_asset_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Watermark Asset Sha256",
          "type": "string"
        },
        "watermark_mode": {
          "const": "alpha_v1",
          "default": "alpha_v1",
          "title": "Watermark Mode",
          "type": "string"
        },
        "watermark_position": {
          "const": "top_right",
          "default": "top_right",
          "title": "Watermark Position",
          "type": "string"
        },
        "watermark_width_permille": {
          "default": 170,
          "maximum": 280,
          "minimum": 80,
          "title": "Watermark Width Permille",
          "type": "integer"
        }
      },
      "required": [
        "cta_asset_id",
        "cta_asset_sha256",
        "cta_asset_name",
        "cta_frame_prefix",
        "cta_frame_count",
        "cta_start_us",
        "cta_end_us",
        "watermark_asset_id",
        "watermark_asset_sha256",
        "watermark_asset_name"
      ],
      "title": "CampaignOverlaySpec",
      "type": "object"
    },
    "RoughCaptionCue": {
      "additionalProperties": false,
      "description": "One provisional caption. Microseconds are canonical. Frames are a render derivative.",
      "properties": {
        "cue_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Cue Id",
          "type": "string"
        },
        "output_end_frame_exclusive": {
          "minimum": 1,
          "title": "Output End Frame Exclusive",
          "type": "integer"
        },
        "output_end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output End Us",
          "type": "integer"
        },
        "output_start_frame": {
          "minimum": 0,
          "title": "Output Start Frame",
          "type": "integer"
        },
        "output_start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output Start Us",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Source End Us",
          "type": "integer"
        },
        "source_start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Source Start Us",
          "type": "integer"
        },
        "text": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "timing_quality": {
          "const": "provisional",
          "default": "provisional",
          "title": "Timing Quality",
          "type": "string"
        },
        "transcript_segment_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Transcript Segment Ids",
          "type": "array"
        },
        "transcript_word_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Transcript Word Ids",
          "type": "array"
        },
        "words": {
          "items": {
            "$ref": "#/$defs/RoughCaptionWord"
          },
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "cue_id",
        "text",
        "transcript_segment_ids",
        "source_start_us",
        "source_end_us",
        "output_start_us",
        "output_end_us",
        "output_start_frame",
        "output_end_frame_exclusive"
      ],
      "title": "RoughCaptionCue",
      "type": "object"
    },
    "RoughCaptionWord": {
      "additionalProperties": false,
      "description": "One provisional word interval carried into a review preview.",
      "properties": {
        "output_end_frame_exclusive": {
          "minimum": 1,
          "title": "Output End Frame Exclusive",
          "type": "integer"
        },
        "output_end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output End Us",
          "type": "integer"
        },
        "output_start_frame": {
          "minimum": 0,
          "title": "Output Start Frame",
          "type": "integer"
        },
        "output_start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output Start Us",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "verification_status": {
          "default": "unverified",
          "enum": [
            "unverified",
            "correct",
            "incorrect"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "word_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Word Id",
          "type": "string"
        }
      },
      "required": [
        "word_id",
        "text",
        "output_start_us",
        "output_end_us",
        "output_start_frame",
        "output_end_frame_exclusive"
      ],
      "title": "RoughCaptionWord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Facts the renderer needs. Python already decided that this candidate is valid.",
  "properties": {
    "audio_path": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Audio Path",
      "type": "string"
    },
    "background": {
      "default": "neutral-dark-v1",
      "enum": [
        "neutral-dark-v1",
        "blurred-source-v1"
      ],
      "title": "Background",
      "type": "string"
    },
    "campaign_overlay": {
      "anyOf": [
        {
          "$ref": "#/$defs/CampaignOverlaySpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "candidate_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "captions": {
      "items": {
        "$ref": "#/$defs/RoughCaptionCue"
      },
      "title": "Captions",
      "type": "array"
    },
    "composition_id": {
      "const": "RoughPreview",
      "default": "RoughPreview",
      "title": "Composition Id",
      "type": "string"
    },
    "duration_in_frames": {
      "minimum": 1,
      "title": "Duration In Frames",
      "type": "integer"
    },
    "font_identity": {
      "default": "dejavu-noto-local-v1",
      "title": "Font Identity",
      "type": "string"
    },
    "fps_denominator": {
      "const": 1,
      "default": 1,
      "title": "Fps Denominator",
      "type": "integer"
    },
    "fps_numerator": {
      "const": 30,
      "default": 30,
      "title": "Fps Numerator",
      "type": "integer"
    },
    "height": {
      "const": 1280,
      "default": 1280,
      "title": "Height",
      "type": "integer"
    },
    "media_trim_frame": {
      "minimum": 0,
      "title": "Media Trim Frame",
      "type": "integer"
    },
    "preview_set_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Preview Set Id",
      "type": "string"
    },
    "proxy_sha256": {
      "default": "",
      "title": "Proxy Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_end_us": {
      "default": 0,
      "minimum": 0,
      "title": "Source End Us",
      "type": "integer"
    },
    "source_start_us": {
      "default": 0,
      "minimum": 0,
      "title": "Source Start Us",
      "type": "integer"
    },
    "staged_audio_sha256": {
      "default": "",
      "title": "Staged Audio Sha256",
      "type": "string"
    },
    "staged_duration_us": {
      "default": 0,
      "minimum": 0,
      "title": "Staged Duration Us",
      "type": "integer"
    },
    "staged_video_sha256": {
      "default": "",
      "title": "Staged Video Sha256",
      "type": "string"
    },
    "timing_quality": {
      "const": "provisional",
      "default": "provisional",
      "title": "Timing Quality",
      "type": "string"
    },
    "video_fit": {
      "const": "contain",
      "default": "contain",
      "title": "Video Fit",
      "type": "string"
    },
    "video_offset_x_px": {
      "default": 0,
      "maximum": 120,
      "minimum": -120,
      "title": "Video Offset X Px",
      "type": "integer"
    },
    "video_path": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Video Path",
      "type": "string"
    },
    "video_scale_permille": {
      "default": 1000,
      "maximum": 1250,
      "minimum": 1000,
      "title": "Video Scale Permille",
      "type": "integer"
    },
    "width": {
      "const": 720,
      "default": 720,
      "title": "Width",
      "type": "integer"
    },
    "word_highlight_mode": {
      "default": "off",
      "enum": [
        "off",
        "reviewed"
      ],
      "title": "Word Highlight Mode",
      "type": "string"
    },
    "word_timing_source": {
      "default": "segment-only-v1",
      "enum": [
        "segment-only-v1",
        "transcript-word-times-v1",
        "reviewed-word-times-v1"
      ],
      "title": "Word Timing Source",
      "type": "string"
    }
  },
  "required": [
    "candidate_id",
    "preview_set_id",
    "video_path",
    "audio_path",
    "media_trim_frame",
    "duration_in_frames"
  ],
  "title": "RoughPreviewRenderInput",
  "type": "object"
}
