{
  "$defs": {
    "CampaignCandidateRecord": {
      "additionalProperties": false,
      "description": "Why one candidate was kept. The runner does not approve it.",
      "properties": {
        "advanced_artifact_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Advanced Artifact Id"
        },
        "alignment_status": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Alignment Status",
          "type": "string"
        },
        "candidate_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "caption_quality": {
          "default": "provisional",
          "maxLength": 40,
          "minLength": 1,
          "title": "Caption Quality",
          "type": "string"
        },
        "delivery_status": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Delivery Status",
          "type": "string"
        },
        "hero_artifact_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hero Artifact Id"
        },
        "hero_review_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hero Review Id"
        },
        "narration_status": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Narration Status",
          "type": "string"
        },
        "preview_artifact_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preview Artifact Id"
        },
        "qa_status": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Qa Status",
          "type": "string"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "review_decision": {
          "default": "not_recorded",
          "maxLength": 40,
          "minLength": 1,
          "title": "Review Decision",
          "type": "string"
        },
        "review_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Id"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "default": "unavailable",
          "maxLength": 40,
          "minLength": 1,
          "title": "Score",
          "type": "string"
        },
        "selection_reason": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Selection Reason",
          "type": "string"
        },
        "source_end_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source End Us"
        },
        "source_start_us": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Start Us"
        }
      },
      "required": [
        "candidate_id",
        "rank",
        "selection_reason",
        "alignment_status",
        "narration_status",
        "qa_status",
        "delivery_status"
      ],
      "title": "CampaignCandidateRecord",
      "type": "object"
    },
    "CampaignStageRecord": {
      "additionalProperties": false,
      "description": "One stage for one source. A cache hit still names the producer it reused.",
      "properties": {
        "artifact_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Id"
        },
        "artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Sha256"
        },
        "cache_hit": {
          "default": false,
          "title": "Cache Hit",
          "type": "boolean"
        },
        "job_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "reason_code": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "enum": [
            "source_verify",
            "ingest",
            "media_prepare",
            "transcribe",
            "vision",
            "mine",
            "preview",
            "review",
            "align",
            "hero_plan",
            "hero_render",
            "advanced",
            "qa",
            "narration",
            "delivery"
          ],
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "succeeded",
            "partial",
            "blocked",
            "failed",
            "cancelled",
            "not_run"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "status",
        "reason_code"
      ],
      "title": "CampaignStageRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
