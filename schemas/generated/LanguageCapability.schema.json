{
  "additionalProperties": false,
  "description": "What a named provider claims. Absence is not support.",
  "properties": {
    "capability": {
      "enum": [
        "transcript",
        "alignment",
        "captions",
        "narration"
      ],
      "title": "Capability",
      "type": "string"
    },
    "language": {
      "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$",
      "title": "Language",
      "type": "string"
    },
    "provider_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Provider Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "supported_status": {
      "enum": [
        "supported",
        "optional",
        "not_claimed",
        "unsupported"
      ],
      "title": "Supported Status",
      "type": "string"
    }
  },
  "required": [
    "provider_id",
    "language",
    "capability",
    "supported_status"
  ],
  "title": "LanguageCapability",
  "type": "object"
}
