{
  "$defs": {
    "DirectionAssetPlacement": {
      "additionalProperties": false,
      "description": "A reviewed, source-grounded placement for one local asset.\n\nAsset timing is never inferred from the number of assets. The selected\noption must name the exact output interval, the source evidence that makes\nthe asset relevant, and a plain-language editorial reason. The renderer\nconsumes this declarative record; it cannot execute operator code.",
      "properties": {
        "asset_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Asset Id",
          "type": "string"
        },
        "asset_tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 24,
          "title": "Asset Tags",
          "type": "array"
        },
        "gain_db": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": -24,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gain Db"
        },
        "interval": {
          "$ref": "#/$defs/OutputInterval"
        },
        "kind": {
          "enum": [
            "graphic",
            "audio"
          ],
          "title": "Kind",
          "type": "string"
        },
        "placement_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Placement Id",
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/MotionPurpose"
        },
        "relevance_note": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Relevance Note",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_evidence_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "source_in_us": {
          "default": 0,
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Source In Us",
          "type": "integer"
        }
      },
      "required": [
        "placement_id",
        "asset_id",
        "kind",
        "interval",
        "source_evidence_ids",
        "purpose",
        "relevance_note"
      ],
      "title": "DirectionAssetPlacement",
      "type": "object"
    },
    "DirectionBeat": {
      "additionalProperties": false,
      "description": "One hook/body/punch beat. Text is copied from the source evidence.",
      "properties": {
        "beat_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Beat Id",
          "type": "string"
        },
        "display_text": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Text"
        },
        "evidence_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "hook",
            "body",
            "punch"
          ],
          "title": "Kind",
          "type": "string"
        },
        "output_end_us": {
          "anyOf": [
            {
              "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
              "maximum": 604800000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output End Us"
        },
        "output_start_us": {
          "anyOf": [
            {
              "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
              "maximum": 604800000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Start Us"
        },
        "purpose": {
          "enum": [
            "context",
            "contrast",
            "consequence",
            "payoff"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_segment_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Segment Ids",
          "type": "array"
        }
      },
      "required": [
        "beat_id",
        "kind",
        "purpose",
        "source_segment_ids",
        "evidence_ids"
      ],
      "title": "DirectionBeat",
      "type": "object"
    },
    "DirectionCameraMotion": {
      "additionalProperties": false,
      "description": "A bounded, source-grounded camera move for one output interval.",
      "properties": {
        "easing": {
          "default": "ease_in_out_cubic",
          "enum": [
            "linear",
            "ease_out_cubic",
            "ease_in_out_cubic"
          ],
          "title": "Easing",
          "type": "string"
        },
        "fallback": {
          "default": "hold",
          "enum": [
            "hold",
            "contain"
          ],
          "title": "Fallback",
          "type": "string"
        },
        "intensity": {
          "default": "gentle",
          "enum": [
            "quiet",
            "gentle",
            "active",
            "peak"
          ],
          "title": "Intensity",
          "type": "string"
        },
        "intent": {
          "enum": [
            "orient",
            "follow",
            "reveal",
            "emphasize",
            "transition",
            "settle"
          ],
          "title": "Intent",
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/OutputInterval"
        },
        "motion_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Motion Id",
          "type": "string"
        },
        "path": {
          "enum": [
            "hold",
            "push_in",
            "pull_out",
            "pan_x",
            "pan_y",
            "drift",
            "parallax",
            "match_cut"
          ],
          "title": "Path",
          "type": "string"
        },
        "scale_end_permille": {
          "default": 1000,
          "maximum": 1140,
          "minimum": 1000,
          "title": "Scale End Permille",
          "type": "integer"
        },
        "scale_start_permille": {
          "default": 1000,
          "maximum": 1140,
          "minimum": 1000,
          "title": "Scale Start Permille",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_evidence_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "target_x_permille": {
          "default": 500,
          "maximum": 1000,
          "minimum": 0,
          "title": "Target X Permille",
          "type": "integer"
        },
        "target_y_permille": {
          "default": 500,
          "maximum": 1000,
          "minimum": 0,
          "title": "Target Y Permille",
          "type": "integer"
        },
        "travel_px": {
          "default": 0,
          "maximum": 194,
          "minimum": 0,
          "title": "Travel Px",
          "type": "integer"
        }
      },
      "required": [
        "motion_id",
        "intent",
        "path",
        "interval",
        "source_evidence_ids"
      ],
      "title": "DirectionCameraMotion",
      "type": "object"
    },
    "DirectionContextLine": {
      "additionalProperties": false,
      "description": "One reviewed, single-line context label in the upper blur lane.\n\nThis is optional for non-campaign directions.  When supplied it is a\ndeclarative editorial summary, never executable copy: the direction\nvalidator binds it to transcript evidence and requires a review note when\nthe wording is not an exact transcript phrase.",
      "properties": {
        "context_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Context Id",
          "type": "string"
        },
        "copy_mode": {
          "default": "exact_evidence",
          "enum": [
            "exact_evidence",
            "human_reviewed_summary",
            "operator_reviewed_summary"
          ],
          "title": "Copy Mode",
          "type": "string"
        },
        "emoji": {
          "enum": [
            "\ud83d\udcd6",
            "\ud83d\udca1",
            "\ud83c\udfaf",
            "\u2728",
            "\u26a1",
            "\ud83e\udde0",
            "\u2705",
            "\ud83d\udd0e",
            "\ud83d\udd4c"
          ],
          "title": "Emoji",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "interval": {
          "$ref": "#/$defs/OutputInterval"
        },
        "review_note": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Note"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "text": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "context_id",
        "text",
        "emoji",
        "evidence_ids",
        "interval"
      ],
      "title": "DirectionContextLine",
      "type": "object"
    },
    "DirectionEvidence": {
      "additionalProperties": false,
      "description": "Verifiable transcript/visual evidence for one editorial choice.",
      "properties": {
        "evidence_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "note": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_segment_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Segment Ids",
          "type": "array"
        },
        "source_text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Source Text",
          "type": "string"
        },
        "source_word_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Word Ids",
          "type": "array"
        },
        "visual_scene_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Visual Scene Ids",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "source_word_ids",
        "source_segment_ids",
        "source_text",
        "note"
      ],
      "title": "DirectionEvidence",
      "type": "object"
    },
    "DirectionMotionGraphic": {
      "additionalProperties": false,
      "description": "A native Remotion illustration tied to exact spoken evidence.\n\nThis is deliberately not an asset placement: it has no downloaded bytes,\nremote URL, or executable payload. ``template`` selects one audited\nrenderer component and ``display_text`` is copied from the evidence named\nbelow.  The lower caption lane is reserved, so an illustration cannot be\nused as a decorative replacement for readable captions.",
      "properties": {
        "display_text": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Display Text",
          "type": "string"
        },
        "graphic_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Graphic Id",
          "type": "string"
        },
        "height": {
          "maximum": 560,
          "minimum": 180,
          "title": "Height",
          "type": "integer"
        },
        "interval": {
          "$ref": "#/$defs/OutputInterval"
        },
        "purpose": {
          "$ref": "#/$defs/MotionPurpose"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_evidence_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "template": {
          "enum": [
            "credit_card",
            "travel_postcard",
            "business_identity",
            "business_spotlight",
            "quran_challenge"
          ],
          "title": "Template",
          "type": "string"
        },
        "width": {
          "maximum": 840,
          "minimum": 220,
          "title": "Width",
          "type": "integer"
        },
        "x": {
          "maximum": 812,
          "minimum": 48,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "maximum": 1240,
          "minimum": 120,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "graphic_id",
        "template",
        "interval",
        "source_evidence_ids",
        "purpose",
        "display_text",
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "DirectionMotionGraphic",
      "type": "object"
    },
    "DirectionTransitionSpec": {
      "additionalProperties": false,
      "description": "A narrative transition selected for one reviewed cut.",
      "properties": {
        "interval": {
          "$ref": "#/$defs/OutputInterval"
        },
        "purpose": {
          "enum": [
            "cut",
            "time_shift",
            "location_change",
            "reveal",
            "emphasis",
            "settle"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sfx_placement_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sfx Placement Id"
        },
        "source_evidence_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "style": {
          "enum": [
            "clean_cut_v1",
            "concat_push_v1",
            "concat_blur_dissolve_v1"
          ],
          "title": "Style",
          "type": "string"
        },
        "transition_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Transition Id",
          "type": "string"
        }
      },
      "required": [
        "transition_id",
        "interval",
        "purpose",
        "style",
        "source_evidence_ids"
      ],
      "title": "DirectionTransitionSpec",
      "type": "object"
    },
    "MotionPurpose": {
      "enum": [
        "number",
        "comparison",
        "product_feature",
        "process_step",
        "concept",
        "visual_reveal",
        "key_phrase",
        "data",
        "ui_interaction"
      ],
      "title": "MotionPurpose",
      "type": "string"
    },
    "OutputInterval": {
      "additionalProperties": false,
      "description": "An interval on the output timeline produced by the candidate's time map.",
      "properties": {
        "clock": {
          "const": "output",
          "default": "output",
          "title": "Clock",
          "type": "string"
        },
        "output_end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output End Us",
          "type": "integer"
        },
        "output_start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output Start Us",
          "type": "integer"
        }
      },
      "required": [
        "output_start_us",
        "output_end_us"
      ],
      "title": "OutputInterval",
      "type": "object"
    },
    "SourceNativeText": {
      "additionalProperties": false,
      "description": "Reviewed text already present in source footage.\n\nThis annotation never paints or removes source pixels. It only gives the\ndeterministic renderer enough evidence to suppress a duplicate optional\ntypography card when the source itself already displays the same phrase.",
      "properties": {
        "interval": {
          "$ref": "#/$defs/OutputInterval"
        },
        "note": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "region_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Region Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "visual_scene_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Visual Scene Ids",
          "type": "array"
        }
      },
      "required": [
        "region_id",
        "interval",
        "text",
        "visual_scene_ids",
        "note"
      ],
      "title": "SourceNativeText",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One source-grounded direction alternative presented to the selector.",
  "properties": {
    "asset_placements": {
      "items": {
        "$ref": "#/$defs/DirectionAssetPlacement"
      },
      "maxItems": 12,
      "title": "Asset Placements",
      "type": "array"
    },
    "beats": {
      "items": {
        "$ref": "#/$defs/DirectionBeat"
      },
      "maxItems": 12,
      "minItems": 3,
      "title": "Beats",
      "type": "array"
    },
    "camera_motion": {
      "items": {
        "$ref": "#/$defs/DirectionCameraMotion"
      },
      "maxItems": 12,
      "title": "Camera Motion",
      "type": "array"
    },
    "context_line": {
      "anyOf": [
        {
          "$ref": "#/$defs/DirectionContextLine"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/DirectionEvidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "motion_graphics": {
      "items": {
        "$ref": "#/$defs/DirectionMotionGraphic"
      },
      "maxItems": 4,
      "title": "Motion Graphics",
      "type": "array"
    },
    "motion_recipe_ids": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Motion Recipe Ids",
      "type": "array"
    },
    "option_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Option Id",
      "type": "string"
    },
    "preset_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preset Id"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "segment_order": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Segment Order",
      "type": "array"
    },
    "selection_reason": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Selection Reason",
      "type": "string"
    },
    "selection_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Selection Score",
