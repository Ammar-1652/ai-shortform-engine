{
  "$defs": {
    "DirectionAssetPlacement": {
      "additionalProperties": false,
      "description": "A reviewed, source-grounded placement for one local asset.\n\nAsset timing is never inferred from the number of assets. The selected\noption must name the exact output interval, the source evidence that makes\nthe asset relevant, and a plain-language editorial reason. The renderer\nconsumes this declarative record; it cannot execute operator code.",
      "properties": {
        "asset_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Asset Id",
          "type": "string"
        },
        "gain_db": {
          "anyOf": [
            {
              "maximum": 6,
              "minimum": -24,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gain Db"
        },
        "interval": {
          "$ref": "#/$defs/OutputInterval"
        },
        "kind": {
          "enum": [
            "graphic",
            "audio"
          ],
          "title": "Kind",
          "type": "string"
        },
        "placement_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Placement Id",
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/MotionPurpose"
        },
        "relevance_note": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Relevance Note",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_evidence_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "source_in_us": {
          "default": 0,
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Source In Us",
          "type": "integer"
        }
      },
      "required": [
        "placement_id",
        "asset_id",
        "kind",
        "interval",
        "source_evidence_ids",
        "purpose",
        "relevance_note"
      ],
      "title": "DirectionAssetPlacement",
      "type": "object"
    },
    "DirectionBeat": {
      "additionalProperties": false,
      "description": "One hook/body/punch beat. Text is copied from the source evidence.",
      "properties": {
        "beat_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Beat Id",
          "type": "string"
        },
        "display_text": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display Text"
        },
        "evidence_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "hook",
            "body",
            "punch"
          ],
          "title": "Kind",
          "type": "string"
        },
        "output_end_us": {
          "anyOf": [
            {
              "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
              "maximum": 604800000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output End Us"
        },
        "output_start_us": {
          "anyOf": [
            {
              "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
              "maximum": 604800000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Start Us"
        },
        "purpose": {
          "enum": [
            "context",
            "contrast",
            "consequence",
            "payoff"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_segment_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Segment Ids",
          "type": "array"
        }
      },
      "required": [
        "beat_id",
        "kind",
        "purpose",
        "source_segment_ids",
        "evidence_ids"
      ],
      "title": "DirectionBeat",
      "type": "object"
    },
    "DirectionEvidence": {
      "additionalProperties": false,
      "description": "Verifiable transcript/visual evidence for one editorial choice.",
      "properties": {
        "evidence_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "note": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Note",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_segment_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Segment Ids",
          "type": "array"
        },
        "source_text": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Source Text",
          "type": "string"
        },
        "source_word_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Word Ids",
          "type": "array"
        },
        "visual_scene_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Visual Scene Ids",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "source_word_ids",
        "source_segment_ids",
        "source_text",
        "note"
      ],
      "title": "DirectionEvidence",
      "type": "object"
    },
    "MotionPurpose": {
      "enum": [
        "number",
        "comparison",
        "product_feature",
        "process_step",
        "concept",
        "visual_reveal",
        "key_phrase",
        "data",
        "ui_interaction"
      ],
      "title": "MotionPurpose",
      "type": "string"
    },
    "OutputInterval": {
      "additionalProperties": false,
      "description": "An interval on the output timeline produced by the candidate's time map.",
      "properties": {
        "clock": {
          "const": "output",
          "default": "output",
          "title": "Clock",
          "type": "string"
        },
        "output_end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output End Us",
          "type": "integer"
        },
        "output_start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output Start Us",
          "type": "integer"
        }
      },
      "required": [
        "output_start_us",
        "output_end_us"
      ],
      "title": "OutputInterval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One source-grounded direction alternative presented to the selector.",
  "properties": {
    "asset_placements": {
      "items": {
        "$ref": "#/$defs/DirectionAssetPlacement"
      },
      "maxItems": 12,
      "title": "Asset Placements",
      "type": "array"
    },
    "beats": {
      "items": {
        "$ref": "#/$defs/DirectionBeat"
      },
      "maxItems": 12,
      "minItems": 3,
      "title": "Beats",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/DirectionEvidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "option_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Option Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "segment_order": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Segment Order",
      "type": "array"
    },
    "selection_reason": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Selection Reason",
      "type": "string"
    },
    "selection_score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Selection Score",
      "type": "number"
    },
    "style_id": {
      "enum": [
        "editorial-clean-v1",
        "kinetic-caption-v1",
        "documentary-broll-v1",
        "data-explainer-v1",
        "paper-explainer-v1",
        "premium-minimal-v1"
      ],
      "title": "Style Id",
      "type": "string"
    },
    "title": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "option_id",
    "style_id",
    "title",
    "beats",
    "evidence",
    "segment_order",
    "selection_score",
    "selection_reason"
  ],
  "title": "DirectionOption",
  "type": "object"
}
