{
  "additionalProperties": false,
  "description": "One source as the operator run handed it to the production runner.",
  "properties": {
    "acquisition_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Acquisition Id"
    },
    "cache_status": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Cache Status",
      "type": "string"
    },
    "delivery_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delivery Id"
    },
    "reason_code": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Reason Code",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "status": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "source_id",
    "source_sha256",
    "status",
    "cache_status",
    "reason_code"
  ],
  "title": "CampaignSourceBinding",
  "type": "object"
}
