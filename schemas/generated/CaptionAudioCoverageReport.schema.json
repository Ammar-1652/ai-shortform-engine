{
  "$defs": {
    "ArtifactProvenance": {
      "additionalProperties": false,
      "description": "Required lineage for stored media decisions and derived artifacts.\n\n``source_asset_ids`` is empty only for records that are not derived from a\nsource video (for example a newly created project). Derived media must list\nthe source.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "inputs_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs Sha256"
        },
        "job_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "parent_artifact_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_asset_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Source Asset Ids",
          "type": "array"
        },
        "tool": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "tool",
        "tool_version"
      ],
      "title": "ArtifactProvenance",
      "type": "object"
    },
    "CaptionCoverageFrame": {
      "additionalProperties": false,
      "description": "One decoded frame at a caption edge or word-highlight boundary.",
      "properties": {
        "frame_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Frame Id",
          "type": "string"
        },
        "frame_index": {
          "minimum": 0,
          "title": "Frame Index",
          "type": "integer"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/CaptionFrameObservation"
          },
          "minItems": 1,
          "title": "Observations",
          "type": "array"
        },
        "output_time_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output Time Us",
          "type": "integer"
        },
        "relative_path": {
          "pattern": "^candidates/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/caption-frames/[A-Za-z0-9][A-Za-z0-9._-]{0,100}\\.png$",
          "title": "Relative Path",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "frame_id",
        "frame_index",
        "output_time_us",
        "observations",
        "relative_path",
        "sha256"
      ],
      "title": "CaptionCoverageFrame",
      "type": "object"
    },
    "CaptionFrameObservation": {
      "additionalProperties": false,
      "description": "A frame may simultaneously own several cue/word boundary roles.",
      "properties": {
        "cue_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cue Id"
        },
        "phase": {
          "enum": [
            "before",
            "start",
            "middle",
            "end",
            "after",
            "first",
            "last",
            "word_start",
            "word_end"
          ],
          "title": "Phase",
          "type": "string"
        },
        "word_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Word Id"
        }
      },
      "required": [
        "phase"
      ],
      "title": "CaptionFrameObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Caption coverage and decoded cue-edge proof for one encoded draft.",
  "properties": {
    "alignment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Alignment Sha256",
      "type": "string"
    },
    "candidate_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "caption_cue_ids": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Caption Cue Ids",
      "type": "array"
    },
    "decoded_frames_status": {
      "const": "complete",
      "default": "complete",
      "title": "Decoded Frames Status",
      "type": "string"
    },
    "encoded_media_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Encoded Media Sha256",
      "type": "string"
    },
    "forced_word_ids": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Forced Word Ids",
      "type": "array"
    },
    "frames": {
      "items": {
        "$ref": "#/$defs/CaptionCoverageFrame"
      },
      "minItems": 1,
      "title": "Frames",
      "type": "array"
    },
    "output_duration_us": {
      "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
      "maximum": 604800000000,
      "minimum": 0,
      "title": "Output Duration Us",
      "type": "integer"
    },
    "output_frame_count": {
      "minimum": 1,
      "title": "Output Frame Count",
      "type": "integer"
    },
    "provenance": {
      "$ref": "#/$defs/ArtifactProvenance"
    },
    "render_input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Render Input Sha256",
      "type": "string"
    },
    "report_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Report Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Asset Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "speech_coverage_status": {
      "default": "insufficient_evidence",
      "enum": [
        "insufficient_evidence",
        "complete"
      ],
      "title": "Speech Coverage Status",
      "type": "string"
    },
    "speech_review_relative_path": {
      "default": "",
      "pattern": "^$|^candidates/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/speech-review\\.json$",
      "title": "Speech Review Relative Path",
      "type": "string"
    },
    "speech_review_sha256": {
      "default": "",
      "pattern": "^$|^[0-9a-f]{64}$",
      "title": "Speech Review Sha256",
      "type": "string"
    },
    "staged_audio_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Staged Audio Sha256",
      "type": "string"
    },
    "time_map_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Time Map Sha256",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "source_asset_id",
    "candidate_id",
    "source_sha256",
    "alignment_sha256",
    "time_map_sha256",
    "render_input_sha256",
    "encoded_media_sha256",
    "staged_audio_sha256",
    "output_duration_us",
    "output_frame_count",
    "forced_word_ids",
    "caption_cue_ids",
    "frames",
    "provenance"
  ],
  "title": "CaptionAudioCoverageReport",
  "type": "object"
}
