      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "title": "Columns",
      "type": "object"
    },
    "formats": {
      "items": {
        "enum": [
          "json",
          "jsonl",
          "csv"
        ],
        "type": "string"
