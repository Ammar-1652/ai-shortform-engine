{
  "additionalProperties": false,
  "properties": {
    "attribution": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attribution"
    },
    "captured_evidence_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Captured Evidence Path"
    },
    "captured_evidence_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Captured Evidence Sha256"
    },
    "captured_response_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Captured Response Sha256",
      "type": "string"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "landing_url": {
      "title": "Landing Url",
      "type": "string"
    },
    "license_code": {
      "title": "License Code",
      "type": "string"
    },
    "license_url": {
      "title": "License Url",
      "type": "string"
    },
    "media_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Media Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "verification_method": {
      "enum": [
        "landing_page",
        "operator_statement",
        "source_provider"
      ],
      "title": "Verification Method",
      "type": "string"
    },
    "verification_status": {
      "enum": [
        "verified",
        "insufficient_evidence",
        "blocked"
      ],
      "title": "Verification Status",
      "type": "string"
    }
  },
  "required": [
    "media_id",
    "landing_url",
    "license_code",
    "license_url",
    "captured_response_sha256",
    "verification_method",
    "verification_status",
    "checked_at"
  ],
  "title": "OpenverseLicenseEvidence",
  "type": "object"
}
