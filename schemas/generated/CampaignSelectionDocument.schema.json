{
  "$defs": {
    "ArtifactProvenance": {
      "additionalProperties": false,
      "description": "Required lineage for stored media decisions and derived artifacts.\n\n``source_asset_ids`` is empty only for records that are not derived from a\nsource video (for example a newly created project). Derived media must list\nthe source.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "inputs_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs Sha256"
        },
        "job_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "parent_artifact_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_asset_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Source Asset Ids",
          "type": "array"
        },
        "tool": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "tool",
        "tool_version"
      ],
      "title": "ArtifactProvenance",
      "type": "object"
    },
    "CampaignSourceChoice": {
      "additionalProperties": false,
      "description": "One catalogue source named by an operator selection.",
      "properties": {
        "rights_state": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Rights State",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_sha256",
        "rights_state"
      ],
      "title": "CampaignSourceChoice",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Append-only record of which sources an operator asked the runner to use.",
  "properties": {
    "campaign_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Campaign Id",
      "type": "string"
    },
    "catalogue_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Catalogue Fingerprint",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evidence_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Fingerprint",
      "type": "string"
    },
    "language": {
      "maxLength": 16,
      "minLength": 2,
      "title": "Language",
      "type": "string"
    },
    "narration_enabled": {
      "title": "Narration Enabled",
      "type": "boolean"
    },
    "narration_policy": {
      "enum": [
        "disabled",
        "optional_english"
      ],
      "title": "Narration Policy",
      "type": "string"
    },
    "operator_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Operator Id",
      "type": "string"
    },
    "policy_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Fingerprint",
      "type": "string"
    },
    "project_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/ArtifactProvenance"
    },
    "publishing": {
      "const": "deferred",
      "default": "deferred",
      "title": "Publishing",
      "type": "string"
    },
    "reason_code": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Reason Code",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selection_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Selection Id",
      "type": "string"
    },
    "source_ids": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Ids",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/CampaignSourceChoice"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "status": {
      "enum": [
        "ready",
        "blocked",
        "stale"
      ],
      "title": "Status",
      "type": "string"
    },
    "whop_live": {
      "const": "not_configured",
      "default": "not_configured",
      "title": "Whop Live",
      "type": "string"
    }
  },
  "required": [
    "selection_id",
    "campaign_id",
    "project_id",
    "source_ids",
    "sources",
    "language",
    "narration_enabled",
    "narration_policy",
    "operator_id",
    "created_at",
    "catalogue_fingerprint",
    "policy_fingerprint",
    "evidence_fingerprint",
    "status",
    "reason_code",
    "provenance"
  ],
  "title": "CampaignSelectionDocument",
  "type": "object"
}
