{
  "$defs": {
    "ManualLabels": {
      "additionalProperties": false,
      "description": "Labels a person typed. ``unknown`` means the person did not supply one.",
      "properties": {
        "audience_tag": {
          "default": "unknown",
          "title": "Audience Tag",
          "type": "string"
        },
        "cta": {
          "default": "unknown",
          "title": "Cta",
          "type": "string"
        },
        "format_tag": {
          "default": "unknown",
          "title": "Format Tag",
          "type": "string"
        },
        "hook_type": {
          "default": "unknown",
          "title": "Hook Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "topic_tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Topic Tags",
          "type": "array"
        }
      },
      "title": "ManualLabels",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A request to append one label set. Unknown keys are rejected.",
  "properties": {
    "artifact_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "campaign_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Campaign Id"
    },
    "confidence": {
      "anyOf": [
        {
          "pattern": "^(?:0(?:\\.[0-9]{1,6})?|1(?:\\.0{1,6})?)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "expected_artifact_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Artifact Sha256"
    },
    "expected_label_set_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Label Set Id"
    },
    "geography": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Geography"
    },
    "labels": {
      "$ref": "#/$defs/ManualLabels"
    },
    "notes": {
      "default": "",
      "maxLength": 500,
      "title": "Notes",
      "type": "string"
    },
    "outcome_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome Id"
    },
    "platform": {
      "anyOf": [
        {
          "pattern": "^(unknown|[a-z][a-z0-9_]{0,31})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Platform"
    },
    "project_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "reviewer_id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Id"
    },
    "source_asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Asset Id",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "source_asset_id",
    "artifact_id",
    "reviewer_id"
  ],
  "title": "EditorialLabelAssignment",
  "type": "object"
}
