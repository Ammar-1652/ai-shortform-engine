{
  "$defs": {
    "OutputInterval": {
      "additionalProperties": false,
      "description": "An interval on the output timeline produced by the candidate's time map.",
      "properties": {
        "clock": {
          "const": "output",
          "default": "output",
          "title": "Clock",
          "type": "string"
        },
        "output_end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output End Us",
          "type": "integer"
        },
        "output_start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output Start Us",
          "type": "integer"
        }
      },
      "required": [
        "output_start_us",
        "output_end_us"
      ],
      "title": "OutputInterval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Hash-bound requested/applied SFX mix policy and measured output facts.",
  "properties": {
    "applied_gain_db": {
      "items": {
        "type": "number"
      },
      "maxItems": 32,
      "title": "Applied Gain Db",
      "type": "array"
    },
    "cue_event_ids": {
      "items": {
        "description": "Stable id. UUID text is the usual value.",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Cue Event Ids",
      "type": "array"
    },
    "duck_db": {
      "items": {
        "type": "number"
      },
      "maxItems": 32,
      "title": "Duck Db",
      "type": "array"
    },
    "fade_in_us": {
      "items": {
        "type": "integer"
      },
      "maxItems": 32,
      "title": "Fade In Us",
      "type": "array"
    },
    "fade_out_us": {
      "items": {
        "type": "integer"
      },
      "maxItems": 32,
      "title": "Fade Out Us",
      "type": "array"
    },
    "intelligibility_checked_windows": {
      "items": {
        "$ref": "#/$defs/OutputInterval"
      },
      "maxItems": 32,
      "title": "Intelligibility Checked Windows",
      "type": "array"
    },
    "intelligibility_encoded_rms_windows": {
      "items": {
        "type": "number"
      },
      "maxItems": 32,
      "title": "Intelligibility Encoded Rms Windows",
      "type": "array"
    },
    "intelligibility_failed_windows": {
      "items": {
        "$ref": "#/$defs/OutputInterval"
      },
      "maxItems": 32,
      "title": "Intelligibility Failed Windows",
      "type": "array"
    },
    "intelligibility_margin_db": {
      "items": {
        "type": "number"
      },
      "maxItems": 32,
      "title": "Intelligibility Margin Db",
      "type": "array"
    },
    "intelligibility_method": {
      "default": "",
      "enum": [
        "",
        "decoded_window_signal_v1",
        "decoded_window_signal_v2",
        "no_audio_cues_v1"
      ],
      "title": "Intelligibility Method",
      "type": "string"
    },
    "intelligibility_note": {
      "default": "",
      "maxLength": 500,
      "title": "Intelligibility Note",
      "type": "string"
    },
    "intelligibility_sfx_reference_rms_windows": {
      "items": {
        "type": "number"
      },
      "maxItems": 32,
      "title": "Intelligibility Sfx Reference Rms Windows",
      "type": "array"
    },
    "intelligibility_speech_reference_rms_windows": {
      "items": {
        "type": "number"
      },
      "maxItems": 32,
      "title": "Intelligibility Speech Reference Rms Windows",
      "type": "array"
    },
    "intelligibility_status": {
      "default": "unverified",
      "enum": [
        "unverified",
        "pass",
        "fail"
      ],
      "title": "Intelligibility Status",
      "type": "string"
    },
    "measured_integrated_lufs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measured Integrated Lufs"
    },
    "measured_rms_windows": {
      "items": {
        "type": "number"
      },
      "maxItems": 128,
      "title": "Measured Rms Windows",
      "type": "array"
    },
    "measured_true_peak_dbfs": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Measured True Peak Dbfs"
    },
    "mix_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Mix Id",
      "type": "string"
    },
    "policy_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Fingerprint",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "silence_windows": {
      "items": {
        "$ref": "#/$defs/OutputInterval"
      },
      "maxItems": 32,
      "title": "Silence Windows",
      "type": "array"
    },
    "source_in_us": {
      "items": {
        "type": "integer"
      },
      "maxItems": 32,
      "title": "Source In Us",
      "type": "array"
    },
    "speech_overlap_windows": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/OutputInterval"
          },
          {
            "type": "null"
          }
        ]
      },
      "maxItems": 32,
      "title": "Speech Overlap Windows",
      "type": "array"
    },
    "status": {
      "default": "planned",
      "enum": [
        "planned",
        "measured"
      ],
      "title": "Status",
      "type": "string"
    },
    "treatment_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Treatment Fingerprint",
      "type": "string"
    }
  },
  "required": [
    "mix_id",
    "treatment_fingerprint",
    "policy_fingerprint"
  ],
  "title": "TreatmentAudioMixResult",
  "type": "object"
}
