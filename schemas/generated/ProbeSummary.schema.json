{
  "additionalProperties": false,
  "description": "Public ffprobe facts. Paths and raw command lines are not stored.",
  "properties": {
    "audio_codec": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Codec"
    },
    "duration_us": {
      "minimum": 0,
      "title": "Duration Us",
      "type": "integer"
    },
    "ffprobe_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Ffprobe Version",
      "type": "string"
    },
    "height": {
      "minimum": 1,
      "title": "Height",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 1,
      "title": "Size Bytes",
      "type": "integer"
    },
    "video_codec": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Video Codec",
      "type": "string"
    },
    "width": {
      "minimum": 1,
      "title": "Width",
      "type": "integer"
    }
  },
  "required": [
    "sha256",
    "size_bytes",
    "duration_us",
    "width",
    "height",
    "video_codec",
    "ffprobe_version"
  ],
  "title": "ProbeSummary",
  "type": "object"
}
