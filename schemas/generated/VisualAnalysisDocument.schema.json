{
  "$defs": {
    "ArtifactProvenance": {
      "additionalProperties": false,
      "description": "Required lineage for stored media decisions and derived artifacts.\n\n``source_asset_ids`` is empty only for records that are not derived from a\nsource video (for example a newly created project). Derived media must list\nthe source.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "inputs_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs Sha256"
        },
        "job_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "parent_artifact_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_asset_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Source Asset Ids",
          "type": "array"
        },
        "tool": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "tool",
        "tool_version"
      ],
      "title": "ArtifactProvenance",
      "type": "object"
    },
    "ContactSheet": {
      "additionalProperties": false,
      "description": "A review image. It is not a timing source.",
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "relative_path": {
          "pattern": "^(frames|contact-sheets)/[A-Za-z0-9][A-Za-z0-9._-]{0,120}$",
          "title": "Relative Path",
          "type": "string"
        },
        "scene_ordinals": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Scene Ordinals",
          "type": "array"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "size_bytes",
        "width",
        "height",
        "scene_ordinals"
      ],
      "title": "ContactSheet",
      "type": "object"
    },
    "EvidenceFile": {
      "additionalProperties": false,
      "description": "One persisted evidence file inside the analysis run directory.",
      "properties": {
        "kind": {
          "enum": [
            "representative_frame",
            "contact_sheet"
          ],
          "title": "Kind",
          "type": "string"
        },
        "relative_path": {
          "pattern": "^(frames|contact-sheets)/[A-Za-z0-9][A-Za-z0-9._-]{0,120}$",
          "title": "Relative Path",
          "type": "string"
        },
        "scene_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Id"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "timestamp_us": {
          "anyOf": [
            {
              "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
              "maximum": 604800000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp Us"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "size_bytes",
        "kind"
      ],
      "title": "EvidenceFile",
      "type": "object"
    },
    "FaceDetectionSample": {
      "additionalProperties": false,
      "description": "One face box on one sampled frame. ``track_id`` is geometry inside that scene only.",
      "properties": {
        "area_ratio": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Area Ratio",
          "type": "number"
        },
        "bounding_box": {
          "$ref": "#/$defs/NormalizedBoundingBox"
        },
        "center_x": {
          "maximum": 1,
          "minimum": 0,
          "title": "Center X",
          "type": "number"
        },
        "center_y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Center Y",
          "type": "number"
        },
        "clamped": {
          "default": false,
          "title": "Clamped",
          "type": "boolean"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "detection_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Detection Id",
          "type": "string"
        },
        "keypoints": {
          "items": {
            "$ref": "#/$defs/FaceKeypoint"
          },
          "title": "Keypoints",
          "type": "array"
        },
        "scene_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timestamp_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Timestamp Us",
          "type": "integer"
        },
        "track_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Id"
        }
      },
      "required": [
        "detection_id",
        "scene_id",
        "timestamp_us",
        "confidence",
        "bounding_box",
        "center_x",
        "center_y",
        "area_ratio"
      ],
      "title": "FaceDetectionSample",
      "type": "object"
    },
    "FaceKeypoint": {
      "additionalProperties": false,
      "description": "A detector keypoint. It is not age, emotion, gender, or identity.",
      "properties": {
        "name": {
          "enum": [
            "left_eye",
            "right_eye",
            "nose",
            "mouth_center"
          ],
          "title": "Name",
          "type": "string"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "name",
        "x",
        "y"
      ],
      "title": "FaceKeypoint",
      "type": "object"
    },
    "FaceObservation": {
      "additionalProperties": false,
      "description": "A detected face over a source interval.\n\nSchema 1.0.0 cannot record this face as the active speaker.",
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "observation_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Observation Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/ArtifactProvenance"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_asset_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Asset Id",
          "type": "string"
        },
        "speaker_attribution": {
          "const": "unknown",
          "default": "unknown",
          "title": "Speaker Attribution",
          "type": "string"
        },
        "time_range": {
          "$ref": "#/$defs/SourceTimeRange"
        },
        "track_id": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Id"
        }
      },
      "required": [
        "observation_id",
        "source_asset_id",
        "time_range",
        "confidence",
        "provenance"
      ],
      "title": "FaceObservation",
      "type": "object"
    },
    "FrameEvidence": {
      "additionalProperties": false,
      "description": "One representative scene frame. Face-only samples are not stored as images.",
      "properties": {
        "actual_timestamp_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Actual Timestamp Us",
          "type": "integer"
        },
        "frame_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Frame Id",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "labels": {
          "items": {
            "enum": [
              "p20",
              "mid",
              "p80"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Labels",
          "type": "array"
        },
        "matched_requests_us": {
          "items": {
            "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
            "maximum": 604800000000,
            "minimum": 0,
            "type": "integer"
          },
          "minItems": 1,
          "title": "Matched Requests Us",
          "type": "array"
        },
        "metrics": {
          "$ref": "#/$defs/FrameVisualMetrics"
        },
        "relative_path": {
          "pattern": "^(frames|contact-sheets)/[A-Za-z0-9][A-Za-z0-9._-]{0,120}$",
          "title": "Relative Path",
          "type": "string"
        },
        "requested_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Requested Us",
          "type": "integer"
        },
        "scene_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "frame_id",
        "scene_id",
        "requested_us",
        "matched_requests_us",
        "actual_timestamp_us",
        "labels",
        "width",
        "height",
        "relative_path",
        "sha256",
        "size_bytes",
        "metrics"
      ],
      "title": "FrameEvidence",
      "type": "object"
    },
    "FrameVisualMetrics": {
      "additionalProperties": false,
      "description": "Numeric frame measurements. These are not quality or engagement scores.",
      "properties": {
        "difference_from_previous_sample": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Difference From Previous Sample"
        },
        "luma_stddev": {
          "minimum": 0,
          "title": "Luma Stddev",
          "type": "number"
        },
        "mean_luma": {
          "maximum": 255,
          "minimum": 0,
          "title": "Mean Luma",
          "type": "number"
        },
        "metrics_version": {
          "const": "1",
          "default": "1",
          "title": "Metrics Version",
          "type": "string"
        },
        "sharpness_laplacian_variance": {
          "minimum": 0,
          "title": "Sharpness Laplacian Variance",
          "type": "number"
        }
      },
      "required": [
        "mean_luma",
        "luma_stddev",
        "sharpness_laplacian_variance"
      ],
      "title": "FrameVisualMetrics",
      "type": "object"
    },
    "NormalizedBoundingBox": {
      "additionalProperties": false,
      "description": "Displayed-proxy coordinates. ``x`` and ``y`` are the top-left corner.",
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "NormalizedBoundingBox",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "description": "A visual scene. Completeness requires visual evidence and transcript evidence.",
      "properties": {
        "analysis_complete": {
          "default": false,
          "title": "Analysis Complete",
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/ArtifactProvenance"
        },
        "scene_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_asset_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Asset Id",
          "type": "string"
        },
        "time_range": {
          "$ref": "#/$defs/SourceTimeRange"
        },
        "transcript_evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transcript Evidence"
        },
        "visual_evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visual Evidence"
        }
      },
      "required": [
        "scene_id",
        "source_asset_id",
        "time_range",
        "provenance"
      ],
      "title": "Scene",
      "type": "object"
    },
    "SceneVisualEvidence": {
      "additionalProperties": false,
      "description": "Deterministic aggregates for one detector scene. No subjective label.",
      "properties": {
        "duration_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Duration Us",
          "type": "integer"
        },
        "evidence_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "face_sample_count": {
          "minimum": 1,
          "title": "Face Sample Count",
          "type": "integer"
        },
        "frames_with_faces": {
          "minimum": 0,
          "title": "Frames With Faces",
          "type": "integer"
        },
        "largest_face_area_ratio_max": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Largest Face Area Ratio Max"
        },
        "max_face_count": {
          "minimum": 0,
          "title": "Max Face Count",
          "type": "integer"
        },
        "mean_luma": {
          "maximum": 255,
          "minimum": 0,
          "title": "Mean Luma",
          "type": "number"
        },
        "mean_sharpness": {
          "minimum": 0,
          "title": "Mean Sharpness",
          "type": "number"
        },
        "mean_visual_difference": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Visual Difference"
        },
        "representative_frame_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Representative Frame Ids",
          "type": "array"
        },
        "sample_count": {
          "minimum": 1,
          "title": "Sample Count",
          "type": "integer"
        },
        "scene_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tracked_face_count": {
          "minimum": 0,
          "title": "Tracked Face Count",
          "type": "integer"
        }
      },
      "required": [
        "evidence_id",
        "scene_id",
        "representative_frame_ids",
        "duration_us",
        "sample_count",
        "face_sample_count",
        "frames_with_faces",
        "max_face_count",
        "mean_luma",
        "mean_sharpness",
        "tracked_face_count"
      ],
      "title": "SceneVisualEvidence",
      "type": "object"
    },
    "SourceTimeRange": {
      "additionalProperties": false,
      "description": "A source-clock interval. Both ends are integer microseconds and ``end_us`` is later than ``start_us``.",
      "properties": {
        "end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "End Us",
          "type": "integer"
        },
        "start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Start Us",
          "type": "integer"
        }
      },
      "required": [
        "start_us",
        "end_us"
      ],
      "title": "SourceTimeRange",
      "type": "object"
    },
    "VisualAnalysisSummary": {
      "additionalProperties": false,
      "description": "Counts and durations. There is no best-scene or recommended-clip field.",
      "properties": {
        "face_detection_count": {
          "minimum": 0,
          "title": "Face Detection Count",
          "type": "integer"
        },
        "face_sample_frame_count": {
          "minimum": 1,
          "title": "Face Sample Frame Count",
          "type": "integer"
        },
        "face_track_count": {
          "minimum": 0,
          "title": "Face Track Count",
          "type": "integer"
        },
        "frames_with_faces": {
          "minimum": 0,
          "title": "Frames With Faces",
          "type": "integer"
        },
        "longest_scene_duration_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Longest Scene Duration Us",
          "type": "integer"
        },
        "max_simultaneous_faces": {
          "minimum": 0,
          "title": "Max Simultaneous Faces",
          "type": "integer"
        },
        "mean_scene_duration_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Mean Scene Duration Us",
          "type": "integer"
        },
        "representative_frame_count": {
          "minimum": 1,
          "title": "Representative Frame Count",
          "type": "integer"
        },
        "scene_count": {
          "minimum": 1,
          "title": "Scene Count",
          "type": "integer"
        },
        "shortest_scene_duration_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Shortest Scene Duration Us",
          "type": "integer"
        }
      },
      "required": [
        "scene_count",
        "representative_frame_count",
        "face_sample_frame_count",
        "face_detection_count",
        "face_track_count",
        "frames_with_faces",
        "max_simultaneous_faces",
        "mean_scene_duration_us",
        "shortest_scene_duration_us",
        "longest_scene_duration_us"
      ],
      "title": "VisualAnalysisSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One immutable visual-analysis run. The direct byte input is the analysis proxy.",
  "properties": {
    "adaptive_threshold": {
      "title": "Adaptive Threshold",
      "type": "number"
    },
    "analysis_id": {
