{
  "$defs": {
    "PublishFile": {
      "additionalProperties": false,
      "description": "One file inside a delivery package. The path is relative to the work root.",
      "properties": {
        "relative_path": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "video",
            "metadata",
            "captions_srt",
            "captions_vtt",
            "narration",
            "checksums",
            "manifest"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "size_bytes",
        "role"
      ],
      "title": "PublishFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Current delivery sidecar. It stores hashes and ids, not filesystem paths.",
  "properties": {
    "advanced_artifact_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Advanced Artifact Sha256",
      "type": "string"
    },
    "advanced_artifact_size_bytes": {
      "minimum": 1,
      "title": "Advanced Artifact Size Bytes",
      "type": "integer"
    },
    "advanced_set_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Advanced Set Id",
      "type": "string"
    },
    "advanced_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Advanced Set Sha256",
      "type": "string"
    },
    "alignment_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Alignment Sha256"
    },
    "approval_review_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Approval Review Id",
      "type": "string"
    },
    "artifact_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "cache_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cache Fingerprint",
      "type": "string"
    },
    "candidate_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_set_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Candidate Set Id",
      "type": "string"
    },
    "candidate_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Set Sha256",
      "type": "string"
    },
    "checksum_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Checksum Sha256",
      "type": "string"
    },
    "checksum_size_bytes": {
      "minimum": 1,
      "title": "Checksum Size Bytes",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "delivery_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Delivery Id",
      "type": "string"
    },
    "delivery_status": {
      "const": "succeeded",
      "default": "succeeded",
      "title": "Delivery Status",
      "type": "string"
    },
    "destination": {
      "const": "local",
      "default": "local",
      "title": "Destination",
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/PublishFile"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "job_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Job Id",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "manifest_size_bytes": {
      "minimum": 1,
      "title": "Manifest Size Bytes",
      "type": "integer"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "profile_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Fingerprint",
      "type": "string"
    },
    "project_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "qa_set_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Qa Set Id",
      "type": "string"
    },
    "qa_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Qa Set Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Asset Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "video_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Video Sha256",
      "type": "string"
    },
    "video_size_bytes": {
      "minimum": 1,
      "title": "Video Size Bytes",
      "type": "integer"
    }
  },
  "required": [
    "project_id",
    "source_asset_id",
    "delivery_id",
    "job_id",
    "artifact_id",
    "source_sha256",
    "candidate_id",
    "candidate_set_id",
    "candidate_set_sha256",
    "advanced_set_id",
    "advanced_set_sha256",
    "advanced_artifact_sha256",
    "advanced_artifact_size_bytes",
    "video_sha256",
    "video_size_bytes",
    "plan_sha256",
    "qa_set_id",
    "qa_set_sha256",
    "approval_review_id",
    "profile_fingerprint",
    "cache_fingerprint",
    "manifest_sha256",
    "manifest_size_bytes",
    "checksum_sha256",
    "checksum_size_bytes",
    "files",
    "created_at"
  ],
  "title": "PublishCacheRecord",
  "type": "object"
}
