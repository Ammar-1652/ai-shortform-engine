{
  "$defs": {
    "SourceTimeRange": {
      "additionalProperties": false,
      "description": "A source-clock interval. Both ends are integer microseconds and ``end_us`` is later than ``start_us``.",
      "properties": {
        "end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "End Us",
          "type": "integer"
        },
        "start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Start Us",
          "type": "integer"
        }
      },
      "required": [
        "start_us",
        "end_us"
      ],
      "title": "SourceTimeRange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One observed fact from an authorized reference or local artifact.",
  "properties": {
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "evidence_kind": {
      "enum": [
        "observed",
        "heuristic",
        "technical",
        "viewer_review",
        "performance"
      ],
      "title": "Evidence Kind",
      "type": "string"
    },
    "evidence_paths": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Evidence Paths",
      "type": "array"
    },
    "interval": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceTimeRange"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "enum": [
        "visual",
        "audio",
        "speech",
        "caption",
        "narrative",
        "pacing",
        "identity",
        "rights"
      ],
      "title": "Kind",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "title": "Limitations",
      "type": "array"
    },
    "method": {
      "enum": [
        "frame_probe",
        "contact_sheet",
        "audio_probe",
        "transcript",
        "human_watch",
        "metadata"
      ],
      "title": "Method",
      "type": "string"
    },
    "observation": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Observation",
      "type": "string"
    },
    "observation_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Observation Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Id",
      "type": "string"
    }
  },
  "required": [
    "observation_id",
    "source_id",
    "kind",
    "observation",
    "method",
    "confidence",
    "evidence_kind",
    "content_sha256"
  ],
  "title": "ReferenceObservation",
  "type": "object"
}
