{
  "$defs": {
    "ArtifactProvenance": {
      "additionalProperties": false,
      "description": "Required lineage for stored media decisions and derived artifacts.\n\n``source_asset_ids`` is empty only for records that are not derived from a\nsource video (for example a newly created project). Derived media must list\nthe source.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "inputs_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs Sha256"
        },
        "job_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "parent_artifact_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_asset_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Source Asset Ids",
          "type": "array"
        },
        "tool": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "tool",
        "tool_version"
      ],
      "title": "ArtifactProvenance",
      "type": "object"
    },
    "TarteelArabicCorrection": {
      "additionalProperties": false,
      "description": "A reviewed spelling correction that keeps the observed source word.",
      "properties": {
        "corrected_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Corrected Text",
          "type": "string"
        },
        "correction_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Correction Id",
          "type": "string"
        },
        "evidence_kind": {
          "enum": [
            "listening_context",
            "campaign_subtitle",
            "canonical_quran"
          ],
          "title": "Evidence Kind",
          "type": "string"
        },
        "locale": {
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$",
          "title": "Locale",
          "type": "string"
        },
        "original_text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Original Text",
          "type": "string"
        },
        "review_note": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Review Note",
          "type": "string"
        },
        "reviewer": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_window_us": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
              "maximum": 604800000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
              "maximum": 604800000000,
              "minimum": 0,
              "type": "integer"
            }
          ],
          "title": "Source Window Us",
          "type": "array"
        },
        "source_word_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Source Word Id",
          "type": "string"
        }
      },
      "required": [
        "correction_id",
        "source_word_id",
        "source_window_us",
        "original_text",
        "corrected_text",
        "locale",
        "evidence_kind",
        "reviewer",
        "review_note"
      ],
      "title": "TarteelArabicCorrection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable source-bound ordinary-Arabic correction evidence.",
  "properties": {
    "campaign": {
      "const": "tarteel",
      "title": "Campaign",
      "type": "string"
    },
    "candidate_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Candidate Id",
      "type": "string"
    },
    "correction_set_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Correction Set Id",
      "type": "string"
    },
    "corrections": {
      "items": {
        "$ref": "#/$defs/TarteelArabicCorrection"
      },
      "title": "Corrections",
      "type": "array"
    },
    "locale": {
      "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$",
      "title": "Locale",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/ArtifactProvenance"
    },
    "raw_asr_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Asr Sha256",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "reviewer": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Reviewer",
      "type": "string"
    },
    "reviewer_role": {
      "anyOf": [
        {
          "enum": [
            "codex_operator",
            "human_reviewer"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer Role"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Asset Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "transcript_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Transcript Sha256",
      "type": "string"
    }
  },
  "required": [
    "correction_set_id",
    "campaign",
    "source_asset_id",
    "candidate_id",
    "source_sha256",
    "raw_asr_sha256",
    "transcript_sha256",
    "locale",
    "reviewer",
    "reviewed_at",
    "provenance"
  ],
  "title": "TarteelArabicCorrectionDocument",
  "type": "object"
}
