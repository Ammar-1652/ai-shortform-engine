{
  "$defs": {
    "DiagramPayload": {
      "additionalProperties": false,
      "description": "Structured diagram facts. Unknown keys are rejected by the base model.",
      "properties": {
        "kind": {
          "enum": [
            "number_comparison",
            "two_step",
            "callout"
          ],
          "title": "Kind",
          "type": "string"
        },
        "left_display": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Left Display"
        },
        "left_label": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Left Label",
          "type": "string"
        },
        "left_value": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Left Value",
          "type": "integer"
        },
        "right_display": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right Display"
        },
        "right_label": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Right Label",
          "type": "string"
        },
        "right_value": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Right Value",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "left_label",
        "right_label",
        "left_value",
        "right_value"
      ],
      "title": "DiagramPayload",
      "type": "object"
    },
    "MotionPurpose": {
      "enum": [
        "number",
        "comparison",
        "product_feature",
        "process_step",
        "concept",
        "visual_reveal",
        "key_phrase",
        "data",
        "ui_interaction"
      ],
      "title": "MotionPurpose",
      "type": "string"
    },
    "OutputInterval": {
      "additionalProperties": false,
      "description": "An interval on the output timeline produced by the candidate's time map.",
      "properties": {
        "clock": {
          "const": "output",
          "default": "output",
          "title": "Clock",
          "type": "string"
        },
        "output_end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output End Us",
          "type": "integer"
        },
        "output_start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output Start Us",
          "type": "integer"
        }
      },
      "required": [
        "output_start_us",
        "output_end_us"
      ],
      "title": "OutputInterval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A local diagram. Geometry is numbers, not an SVG or HTML string.",
  "properties": {
    "component_id": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Component Id",
      "type": "string"
    },
    "event_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Event Id",
      "type": "string"
    },
    "height": {
      "maximum": 600,
      "minimum": 80,
      "title": "Height",
      "type": "integer"
    },
    "interval": {
      "$ref": "#/$defs/OutputInterval"
    },
    "payload": {
      "$ref": "#/$defs/DiagramPayload"
    },
    "purpose": {
      "$ref": "#/$defs/MotionPurpose"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "width": {
      "maximum": 900,
      "minimum": 80,
      "title": "Width",
      "type": "integer"
    },
    "x": {
      "minimum": 48,
      "title": "X",
      "type": "integer"
    },
    "y": {
      "minimum": 48,
      "title": "Y",
      "type": "integer"
    }
  },
  "required": [
    "event_id",
    "interval",
    "purpose",
    "component_id",
    "payload",
    "x",
    "y",
    "width",
    "height"
  ],
  "title": "DiagramEvent",
  "type": "object"
}
