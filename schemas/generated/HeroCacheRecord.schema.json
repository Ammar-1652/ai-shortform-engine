  "required": [
    "project_id",
    "source_asset_id",
    "hero_set_id",
    "job_id",
    "source_sha256",
    "candidate_set_artifact_id",
    "candidate_set_sha256",
    "transcript_id",
    "transcript_sha256",
    "visual_analysis_id",
    "visual_analysis_sha256",
    "analysis_proxy_sha256",
    "asr_audio_sha256",
    "rough_preview_artifact_id",
    "rough_preview_set_id",
    "rough_manifest_sha256",
    "hero_input_sha256",
    "profile_fingerprint",
    "alignment_model",
    "whisperx_version",
    "alignment_config_sha256",
    "manifest_sha256",
    "manifest_size_bytes",
    "rendered_count",
    "validation_status",
    "created_at"
  ],
  "title": "HeroCacheRecord",
  "type": "object"
}
