{
  "additionalProperties": false,
  "description": "Sidecar for the current Hero draft set. ``created_at`` is not identity.",
  "properties": {
    "alignment_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Alignment Config Sha256",
      "type": "string"
    },
    "alignment_model": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Alignment Model",
      "type": "string"
    },
    "analysis_proxy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Analysis Proxy Sha256",
      "type": "string"
    },
    "asr_audio_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Asr Audio Sha256",
      "type": "string"
    },
    "candidate_set_artifact_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Candidate Set Artifact Id",
      "type": "string"
    },
    "candidate_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Candidate Set Sha256",
      "type": "string"
    },
    "caption_algorithm_version": {
      "const": "hero-caption-v1",
      "default": "hero-caption-v1",
      "title": "Caption Algorithm Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "hero_input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Hero Input Sha256",
      "type": "string"
    },
    "hero_set_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Hero Set Id",
      "type": "string"
    },
    "job_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Job Id",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "manifest_size_bytes": {
      "minimum": 1,
      "title": "Manifest Size Bytes",
      "type": "integer"
    },
    "motion_library_version": {
      "const": "motion-library-v1",
      "default": "motion-library-v1",
      "title": "Motion Library Version",
      "type": "string"
    },
    "profile_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Profile Fingerprint",
      "type": "string"
    },
    "project_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "rendered_count": {
      "minimum": 1,
      "title": "Rendered Count",
      "type": "integer"
    },
    "renderer_recipe_version": {
      "const": "hero-draft-renderer-v1",
      "default": "hero-draft-renderer-v1",
      "title": "Renderer Recipe Version",
      "type": "string"
    },
    "rough_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rough Manifest Sha256",
      "type": "string"
    },
    "rough_preview_artifact_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Rough Preview Artifact Id",
      "type": "string"
    },
    "rough_preview_set_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Rough Preview Set Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Asset Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "transcript_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Transcript Id",
      "type": "string"
    },
    "transcript_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Transcript Sha256",
      "type": "string"
    },
    "validation_status": {
      "const": "passed",
      "title": "Validation Status",
      "type": "string"
    },
    "visual_analysis_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Visual Analysis Id",
      "type": "string"
    },
    "visual_analysis_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Visual Analysis Sha256",
      "type": "string"
    },
    "whisperx_version": {
      "maxLength": 40,
      "minLength": 1,
      "title": "Whisperx Version",
      "type": "string"
    }
