{
  "$defs": {
    "AudioMixEvent": {
      "additionalProperties": false,
      "description": "One SFX cue. Music is not a role in this schema.",
      "properties": {
        "asset_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Asset Id",
          "type": "string"
        },
        "event_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Event Id",
          "type": "string"
        },
        "fade_in_us": {
          "default": 20000,
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Fade In Us",
          "type": "integer"
        },
        "fade_out_us": {
          "default": 60000,
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Fade Out Us",
          "type": "integer"
        },
        "gain_db": {
          "maximum": 6,
          "minimum": -24,
          "title": "Gain Db",
          "type": "number"
        },
        "interval": {
          "$ref": "#/$defs/OutputInterval"
        },
        "purpose": {
          "anyOf": [
            {
              "$ref": "#/$defs/MotionPurpose"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "relevance_note": {
          "default": "",
          "maxLength": 500,
          "title": "Relevance Note",
          "type": "string"
        },
        "role": {
          "const": "sfx",
          "default": "sfx",
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sfx_source_in_us": {
          "default": 0,
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Sfx Source In Us",
          "type": "integer"
        },
        "source_evidence_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Source Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "interval",
        "asset_id",
        "gain_db"
      ],
      "title": "AudioMixEvent",
      "type": "object"
    },
    "BrollEvent": {
      "additionalProperties": false,
      "description": "B-roll on the output clock, with an in-point on the B-roll asset's own clock.",
      "properties": {
        "asset_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Asset Id",
          "type": "string"
        },
        "broll_source_in_us": {
          "description": "In-point on the B-roll asset clock. Not a program-timeline time.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Broll Source In Us",
          "type": "integer"
        },
        "event_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Event Id",
          "type": "string"
        },
        "interval": {
          "$ref": "#/$defs/OutputInterval"
        },
        "relevance_note": {
          "default": "",
          "maxLength": 500,
          "title": "Relevance Note",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_evidence_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Source Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "event_id",
        "interval",
        "asset_id",
        "broll_source_in_us"
      ],
      "title": "BrollEvent",
      "type": "object"
    },
    "CaptionWordTiming": {
      "additionalProperties": false,
      "description": "One forced word inside a grouped Advanced Hero caption.",
      "properties": {
        "output_end_frame_exclusive": {
          "minimum": 1,
          "title": "Output End Frame Exclusive",
          "type": "integer"
        },
        "output_end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output End Us",
          "type": "integer"
        },
        "output_start_frame": {
          "minimum": 0,
          "title": "Output Start Frame",
          "type": "integer"
        },
        "output_start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output Start Us",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "word_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Word Id",
          "type": "string"
        }
      },
      "required": [
        "word_id",
        "text",
        "output_start_us",
        "output_end_us",
        "output_start_frame",
        "output_end_frame_exclusive"
      ],
      "title": "CaptionWordTiming",
      "type": "object"
    },
    "DiagramEvent": {
      "additionalProperties": false,
      "description": "A local diagram. Geometry is numbers, not an SVG or HTML string.",
      "properties": {
        "component_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "event_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Event Id",
          "type": "string"
        },
        "height": {
          "maximum": 600,
          "minimum": 80,
          "title": "Height",
          "type": "integer"
        },
        "interval": {
          "$ref": "#/$defs/OutputInterval"
        },
        "payload": {
          "$ref": "#/$defs/DiagramPayload"
        },
        "purpose": {
          "$ref": "#/$defs/MotionPurpose"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "width": {
          "maximum": 900,
          "minimum": 80,
          "title": "Width",
          "type": "integer"
        },
        "x": {
          "minimum": 48,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 48,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "interval",
        "purpose",
        "component_id",
        "payload",
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "DiagramEvent",
      "type": "object"
    },
    "DiagramPayload": {
      "additionalProperties": false,
      "description": "Structured diagram facts. Unknown keys are rejected by the base model.",
      "properties": {
        "kind": {
          "enum": [
            "number_comparison",
            "two_step",
            "callout"
          ],
          "title": "Kind",
          "type": "string"
        },
        "left_display": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Left Display"
        },
        "left_label": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Left Label",
          "type": "string"
        },
        "left_value": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Left Value",
          "type": "integer"
        },
        "right_display": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right Display"
        },
        "right_label": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Right Label",
          "type": "string"
        },
        "right_value": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Right Value",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "left_label",
        "right_label",
        "left_value",
        "right_value"
      ],
      "title": "DiagramPayload",
      "type": "object"
    },
    "EmphasisEvent": {
      "additionalProperties": false,
      "description": "One forced word selected by a named rule. Text is copied.",
      "properties": {
        "event_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Event Id",
          "type": "string"
        },
        "output_end_frame_exclusive": {
          "minimum": 1,
          "title": "Output End Frame Exclusive",
          "type": "integer"
        },
        "output_end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output End Us",
          "type": "integer"
        },
        "output_start_frame": {
          "minimum": 0,
          "title": "Output Start Frame",
          "type": "integer"
        },
        "output_start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output Start Us",
          "type": "integer"
        },
        "purpose": {
          "$ref": "#/$defs/MotionPurpose"
        },
        "rule_id": {
          "enum": [
            "number_or_currency",
            "terminal_punctuation",
            "diagram_label"
          ],
          "title": "Rule Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "word_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Word Id",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "word_id",
        "text",
        "output_start_us",
        "output_end_us",
        "output_start_frame",
        "output_end_frame_exclusive",
        "purpose",
        "rule_id"
      ],
      "title": "EmphasisEvent",
      "type": "object"
    },
    "MotionGraphicEvent": {
      "additionalProperties": false,
      "description": "One source-grounded native Remotion illustration.\n\nThe template is an allowlisted renderer component, never operator-supplied\nJSX, SVG, CSS, or a remote asset.  Text and evidence stay in the typed plan\nso a visual cannot become a free-floating unsupported claim.",
      "properties": {
        "display_text": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Display Text",
          "type": "string"
        },
        "event_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Event Id",
          "type": "string"
        },
        "height": {
          "maximum": 560,
          "minimum": 180,
          "title": "Height",
          "type": "integer"
        },
        "interval": {
          "$ref": "#/$defs/OutputInterval"
        },
        "purpose": {
          "$ref": "#/$defs/MotionPurpose"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_evidence_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "template": {
          "enum": [
            "credit_card",
            "travel_postcard",
            "business_spotlight"
          ],
          "title": "Template",
          "type": "string"
        },
        "width": {
          "maximum": 840,
          "minimum": 220,
          "title": "Width",
          "type": "integer"
        },
        "x": {
          "maximum": 812,
          "minimum": 48,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "maximum": 1240,
          "minimum": 120,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "template",
        "interval",
        "purpose",
        "source_evidence_ids",
        "display_text",
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "MotionGraphicEvent",
      "type": "object"
    },
    "MotionPurpose": {
      "enum": [
        "number",
        "comparison",
        "product_feature",
        "process_step",
        "concept",
        "visual_reveal",
        "key_phrase",
        "data",
        "ui_interaction"
      ],
      "title": "MotionPurpose",
      "type": "string"
    },
    "MotionStyleSpec": {
      "additionalProperties": false,
      "description": "Serializable numeric style choices consumed by Python and Remotion.",
      "properties": {
        "accent": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "title": "Accent",
          "type": "string"
        },
        "caption_mode": {
          "enum": [
            "phrase_active_word",
            "phrase_whole_run"
          ],
          "title": "Caption Mode",
          "type": "string"
        },
        "contrast": {
          "enum": [
            "legacy",
            "outline_shadow_backplate",
            "soft_backplate",
            "minimal_outline"
          ],
          "title": "Contrast",
          "type": "string"
        },
        "easing": {
          "enum": [
            "linear",
            "ease_out_cubic",
            "ease_in_out_cubic"
          ],
          "title": "Easing",
          "type": "string"
        },
        "enter_frames": {
          "maximum": 30,
          "minimum": 0,
          "title": "Enter Frames",
          "type": "integer"
        },
        "exit_frames": {
          "maximum": 30,
          "minimum": 0,
          "title": "Exit Frames",
          "type": "integer"
        },
        "font_identity": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Font Identity",
          "type": "string"
        },
        "font_sha256": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Font Sha256",
          "type": "array"
        },
        "max_scale_permille": {
          "maximum": 1100,
          "minimum": 1000,
          "title": "Max Scale Permille",
          "type": "integer"
        },
        "max_simultaneous_emphasis": {
          "maximum": 2,
          "minimum": 0,
          "title": "Max Simultaneous Emphasis",
          "type": "integer"
        },
        "max_travel_px": {
          "maximum": 80,
          "minimum": 0,
          "title": "Max Travel Px",
          "type": "integer"
        },
        "safe_bottom": {
          "maximum": 500,
          "minimum": 0,
          "title": "Safe Bottom",
          "type": "integer"
        },
        "safe_left": {
          "maximum": 300,
          "minimum": 0,
          "title": "Safe Left",
          "type": "integer"
        },
        "safe_right": {
          "maximum": 300,
          "minimum": 0,
          "title": "Safe Right",
          "type": "integer"
        },
        "safe_top": {
          "maximum": 400,
          "minimum": 0,
          "title": "Safe Top",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "style_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Style Id",
          "type": "string"
        }
      },
      "required": [
        "style_id",
        "easing",
        "enter_frames",
        "exit_frames",
        "max_travel_px",
        "max_scale_permille",
        "caption_mode",
        "contrast",
        "font_identity",
        "accent",
        "safe_left",
        "safe_right",
        "safe_top",
        "safe_bottom",
        "max_simultaneous_emphasis"
      ],
      "title": "MotionStyleSpec",
      "type": "object"
    },
    "OutputInterval": {
      "additionalProperties": false,
      "description": "An interval on the output timeline produced by the candidate's time map.",
      "properties": {
        "clock": {
          "const": "output",
          "default": "output",
          "title": "Clock",
          "type": "string"
        },
        "output_end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output End Us",
          "type": "integer"
        },
        "output_start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output Start Us",
          "type": "integer"
        }
      },
      "required": [
        "output_start_us",
        "output_end_us"
      ],
      "title": "OutputInterval",
      "type": "object"
    },
    "ReframingStrategy": {
      "additionalProperties": false,
      "description": "Named crop strategy. It does not identify a speaker.",
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "strategy_id": {
          "enum": [
            "contain",
            "center_crop",
            "manual_window",
            "visual_safe_window",
            "multi_face_safe_window",
            "saliency_window",
            "face_follow"
          ],
          "title": "Strategy Id",
          "type": "string"
        }
      },
      "required": [
        "strategy_id"
      ],
      "title": "ReframingStrategy",
      "type": "object"
    },
    "ReframingWindow": {
      "additionalProperties": false,
      "description": "One crop on the visual frame. Coordinates are pixels inside that frame.",
      "properties": {
        "frame_height": {
          "minimum": 1,
          "title": "Frame Height",
          "type": "integer"
        },
        "frame_width": {
          "minimum": 1,
          "title": "Frame Width",
          "type": "integer"
        },
        "output_end_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output End Us",
          "type": "integer"
        },
        "output_start_us": {
          "description": "Integer microseconds on the clock named by the parent field. Not seconds or frames.",
          "maximum": 604800000000,
          "minimum": 0,
          "title": "Output Start Us",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_height": {
          "minimum": 1,
          "title": "Source Height",
          "type": "integer"
        },
        "source_width": {
          "minimum": 1,
          "title": "Source Width",
          "type": "integer"
        },
        "source_x": {
          "minimum": 0,
          "title": "Source X",
          "type": "integer"
        },
        "source_y": {
          "minimum": 0,
          "title": "Source Y",
          "type": "integer"
        },
        "strategy_id": {
          "$ref": "#/$defs/ReframingStrategy"
        },
        "window_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Window Id",
          "type": "string"
        }
      },
      "required": [
        "window_id",
        "strategy_id",
        "output_start_us",
        "output_end_us",
        "source_x",
        "source_y",
        "source_width",
        "source_height",
        "frame_width",
        "frame_height"
      ],
      "title": "ReframingWindow",
      "type": "object"
    },
    "TypographyEvent": {
      "additionalProperties": false,
      "description": "On-screen text copied from alignment or a validated payload. It is not HTML.",
      "properties": {
        "color": {
          "const": "#ffffff",
          "default": "#ffffff",
          "title": "Color",
          "type": "string"
        },
        "component_id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "event_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Event Id",
          "type": "string"
        },
        "font_size": {
          "maximum": 96,
          "minimum": 24,
          "title": "Font Size",
          "type": "integer"
        },
        "interval": {
          "$ref": "#/$defs/OutputInterval"
        },
        "purpose": {
          "$ref": "#/$defs/MotionPurpose"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "text": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "words": {
          "items": {
            "$ref": "#/$defs/CaptionWordTiming"
          },
          "title": "Words",
          "type": "array"
        },
        "x": {
          "maximum": 1032,
          "minimum": 48,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "maximum": 1872,
          "minimum": 48,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "event_id",
        "interval",
        "purpose",
        "component_id",
        "text",
        "x",
        "y",
