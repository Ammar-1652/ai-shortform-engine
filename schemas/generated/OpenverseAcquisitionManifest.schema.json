{
  "$defs": {
    "ArtifactProvenance": {
      "additionalProperties": false,
      "description": "Required lineage for stored media decisions and derived artifacts.\n\n``source_asset_ids`` is empty only for records that are not derived from a\nsource video (for example a newly created project). Derived media must list\nthe source.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Created By",
          "type": "string"
        },
        "inputs_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inputs Sha256"
        },
        "job_id": {
          "anyOf": [
            {
              "description": "Stable id. UUID text is the usual value.",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "parent_artifact_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_asset_ids": {
          "items": {
            "description": "Stable id. UUID text is the usual value.",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "title": "Source Asset Ids",
          "type": "array"
        },
        "tool": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Tool",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "created_by",
        "tool",
        "tool_version"
      ],
      "title": "ArtifactProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One promoted Openverse byte acquisition under the local work root.",
  "properties": {
    "acquired_at": {
      "format": "date-time",
      "title": "Acquired At",
      "type": "string"
    },
    "acquisition_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Acquisition Id",
      "type": "string"
    },
    "asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Asset Id",
      "type": "string"
    },
    "attribution": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attribution"
    },
    "campaign_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Campaign Id",
      "type": "string"
    },
    "evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Sha256",
      "type": "string"
    },
    "file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "File Sha256",
      "type": "string"
    },
    "landing_url": {
      "title": "Landing Url",
      "type": "string"
    },
    "license_record_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "License Record Id",
      "type": "string"
    },
    "license_url": {
      "title": "License Url",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "media_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Media Id",
      "type": "string"
    },
    "media_type": {
      "enum": [
        "image",
        "audio"
      ],
      "title": "Media Type",
      "type": "string"
    },
    "policy_fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Fingerprint",
      "type": "string"
    },
    "project_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/ArtifactProvenance"
    },
    "relative_path": {
      "pattern": "^assets/openverse/acquisitions/[A-Za-z0-9._:-]+/media$",
      "title": "Relative Path",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selection_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Selection Id",
      "type": "string"
    },
    "selection_response_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Response Sha256",
      "type": "string"
    },
    "selection_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Selection Sha256",
      "type": "string"
    },
    "size_bytes": {
      "exclusiveMinimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    },
    "source_asset_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Source Asset Id",
      "type": "string"
    },
    "status": {
      "const": "verified",
      "default": "verified",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "acquisition_id",
    "project_id",
    "source_asset_id",
    "campaign_id",
    "selection_id",
    "media_id",
    "media_type",
    "relative_path",
    "file_sha256",
    "size_bytes",
    "landing_url",
    "license_url",
    "policy_fingerprint",
    "selection_response_sha256",
    "selection_sha256",
    "evidence_sha256",
    "asset_id",
    "license_record_id",
    "manifest_sha256",
    "provenance",
    "acquired_at"
  ],
  "title": "OpenverseAcquisitionManifest",
  "type": "object"
}
