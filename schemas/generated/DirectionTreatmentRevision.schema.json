{
  "$defs": {
    "TreatmentBindingReference": {
      "additionalProperties": false,
      "properties": {
        "binding_id": {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "title": "Binding Id",
          "type": "string"
        },
        "relative_path": {
          "pattern": "^editorial/treatment-bindings/[A-Za-z0-9._:-]+\\.json$",
          "title": "Relative Path",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "binding_id",
        "relative_path",
        "sha256"
      ],
      "title": "TreatmentBindingReference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bindings": {
      "items": {
        "$ref": "#/$defs/TreatmentBindingReference"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Bindings",
      "type": "array"
    },
    "parent_direction_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Parent Direction Id",
      "type": "string"
    },
    "parent_direction_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Parent Direction Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "parent_direction_id",
    "parent_direction_sha256",
    "bindings"
  ],
  "title": "DirectionTreatmentRevision",
  "type": "object"
}
