        {
          "$ref": "#/$defs/RationalNumber"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rotation": {
      "$ref": "#/$defs/RotationMetadata"
    },
    "sample_aspect_ratio": {
      "anyOf": [
        {
          "$ref": "#/$defs/RationalNumber"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "start_pts": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
