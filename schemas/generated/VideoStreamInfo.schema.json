    },
    "start_time_us": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start Time Us"
    },
    "time_base": {
      "anyOf": [
        {
          "$ref": "#/$defs/RationalNumber"
        },
        {
          "type": "null"
        }
      ],
      "default": null
