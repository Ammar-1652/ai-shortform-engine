{
  "$defs": {
    "ColorMetadata": {
      "additionalProperties": false,
      "properties": {
        "color_primaries": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Primaries"
        },
        "color_range": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Range"
        },
        "color_space": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Space"
        },
        "color_transfer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Transfer"
        }
      },
      "title": "ColorMetadata",
      "type": "object"
    },
    "RationalNumber": {
      "additionalProperties": false,
      "description": "An exact integer ratio. ``30000/1001`` is not stored as ``29.97``.",
      "properties": {
        "denominator": {
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "title": "Numerator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "RationalNumber",
      "type": "object"
    },
    "RotationMetadata": {
      "additionalProperties": false,
      "description": "Encoded rotation in degrees. ``None`` means ffprobe did not report one.",
      "properties": {
        "degrees": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Degrees"
        }
      },
      "title": "RotationMetadata",
      "type": "object"
    },
    "StreamDisposition": {
      "additionalProperties": false,
      "properties": {
        "attached_pic": {
          "default": false,
          "title": "Attached Pic",
          "type": "boolean"
        },
        "default": {
          "default": false,
          "title": "Default",
          "type": "boolean"
        }
      },
      "title": "StreamDisposition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "avg_frame_rate": {
      "anyOf": [
        {
          "$ref": "#/$defs/RationalNumber"
        },
        {
          "type": "null"
        }
      ],
      "default": null
