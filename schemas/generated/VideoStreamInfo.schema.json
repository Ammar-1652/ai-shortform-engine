      "default": null,
      "title": "Display Height"
    },
    "display_width": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Display Width"
    },
    "disposition": {
      "$ref": "#/$defs/StreamDisposition"
    },
    "duration_ts": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ts"
    },
    "duration_us": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Us"
    },
    "field_order": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
