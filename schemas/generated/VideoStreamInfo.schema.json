    },
    "codec_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Codec Name"
    },
    "color": {
      "$ref": "#/$defs/ColorMetadata"
    },
    "display_aspect_ratio": {
      "anyOf": [
        {
          "$ref": "#/$defs/RationalNumber"
        },
        {
          "type": "null"
        }
      ],
      "default": null
