{
  "additionalProperties": false,
  "description": "A human review. ``automated`` cannot be true in this schema version.",
  "properties": {
    "artifact_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Artifact Id"
    },
    "automated": {
      "const": false,
      "default": false,
      "title": "Automated",
      "type": "boolean"
    },
    "candidate_id": {
      "anyOf": [
        {
          "description": "Stable id. UUID text is the usual value.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected",
        "changes_requested"
      ],
      "title": "Decision",
      "type": "string"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "project_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Project Id",
      "type": "string"
    },
    "review_id": {
      "description": "Stable id. UUID text is the usual value.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Review Id",
      "type": "string"
    },
    "reviewer_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "subject_kind": {
      "enum": [
        "candidate",
        "hero",
        "caption",
        "framing",
        "final"
      ],
      "title": "Subject Kind",
      "type": "string"
    }
  },
  "required": [
    "review_id",
    "project_id",
    "subject_kind",
    "decision",
    "reviewer_id",
    "created_at"
  ],
  "title": "ReviewDecision",
  "type": "object"
}
