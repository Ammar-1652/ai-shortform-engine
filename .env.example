# Copy to .env if you want a reminder of optional variables.
# clipforge does not load this file. Export the variables in your shell.

# Artifact directory. Default: var/work
# CLIPFORGE_WORK_ROOT wins when both are set. WORK_ROOT remains accepted.
CLIPFORGE_WORK_ROOT=
WORK_ROOT=

# Free-space reserve in gibibytes. Default: 10. There is no flag to disable it.
CLIPFORGE_DISK_RESERVE_GB=

# Optional executable overrides. Each value must be an executable file.
# CLIPFORGE_FFMPEG=
# CLIPFORGE_FFPROBE=

# SQLite file. Default: var/clipforge.sqlite3
DATABASE_PATH=

# Model weights. Default: var/models. Not the work root. Never commit this directory.
CLIPFORGE_MODEL_ROOT=

# External speech WAV directory. Alignment is verified_live only when the file
# under this root matches the packaged speech record. Leave empty when absent.
CLIPFORGE_SPEECH_EVIDENCE_ROOT=

# Future Envato MCP endpoint. Unused in Round 1.
ENVATO_MCP_URL=
